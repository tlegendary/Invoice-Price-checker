            "state": "translated",
            "value": "نرجو إصدار إشعار دائن بهذا المبلغ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تکایە بەم بڕە پسوولەی گەڕاندنەوەی پارە دەربکەن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
