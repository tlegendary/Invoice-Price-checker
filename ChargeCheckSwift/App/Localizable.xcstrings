    "Leave a supplier empty if you didn't pay them. Each amount pays off that supplier's oldest invoices first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك المورّد فارغًا إن لم تدفع له. كل مبلغ يسدّد أقدم فواتيره أولًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەگەر پارەت بە دابینکەرێک نەداوە بەتاڵی جێبهێڵە. هەر بڕێک سەرەتا کۆنترین پسوولەکانی دەداتەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass einen Lieferanten leer, wenn du ihn nicht bezahlt hast. Jeder Betrag begleicht zuerst seine ältesten Rechnungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide un fournisseur que vous n’avez pas payé. Chaque montant règle d’abord ses plus anciennes factures."
          }
        }
      }
    },
