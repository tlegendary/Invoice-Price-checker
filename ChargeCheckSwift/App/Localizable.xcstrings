            "value": "Un magasin"
          }
        }
      }
    },
    "Only %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط %@"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تەنها %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement %@"
          }
        }
      }
    },
    "Only for credits that weren't already taken off one of their invoices in ChargeCheck.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط للإشعارات الدائنة التي لم تُخصم من إحدى فواتيرهم في ChargeCheck."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تەنها بۆ ئەو گەڕاندنەوانەی پێشتر لە یەکێک لە پسوولەکانیان لە ChargeCheck نەبڕدراون."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Gutschriften, die nicht schon bei einer Rechnung in ChargeCheck abgezogen wurden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour les avoirs qui n’ont pas déjà été déduits d’une de leurs factures dans ChargeCheck."
          }
        }
      }
    },
    "Only found on the second read – make sure it's really on the invoice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وُجد في القراءة الثانية فقط – تأكّد أنه موجود فعلًا في الفاتورة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تەنها لە خوێندنەوەی دووەمدا دۆزرایەوە – دڵنیا بەرەوە کە بەڕاستی لەسەر پسوولەکەیە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur beim zweiten Lesen gefunden – prüfe, ob sie wirklich auf der Rechnung steht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvée seulement à la deuxième lecture – vérifiez qu’elle est bien sur la facture."
          }
        }
      }
    },
    "Only invoices from %@ are checked against this price.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفحص فواتير %@ فقط بهذا السعر."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تەنها پسوولەکانی %@ بەم نرخە دەپشکنرێن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Rechnungen von %@ werden mit diesem Preis geprüft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les factures de %@ sont vérifiées avec ce prix."
          }
        }
      }
    },
    "Only needed if you have more than one shop. Each invoice is filed under a shop, and Reports can show each shop on its own. Your prices are shared by all shops.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب فقط إذا كان لديك أكثر من متجر. تُحفظ كل فاتورة تحت متجر، ويمكن للتقارير عرض كل متجر وحده. أسعارك مشتركة بين كل المتاجر."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تەنها پێویستە ئەگەر زیاتر لە یەک دوکانت هەیە. هەر پسوولەیەک لەژێر دوکانێکدا هەڵدەگیرێت، و ڕاپۆرتەکان دەتوانن هەر دوکانێک بە جیا پیشان بدەن. نرخەکانت بۆ هەموو دوکانەکان هاوبەشن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur nötig, wenn du mehr als eine Filiale hast. Jede Rechnung wird einer Filiale zugeordnet, und die Berichte können jede Filiale einzeln zeigen. Deine Preise gelten für alle Filialen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utile seulement si vous avez plusieurs magasins. Chaque facture est classée sous un magasin, et les rapports peuvent montrer chaque magasin séparément. Vos prix sont partagés par tous les magasins."
          }
        }
      }
    },
    "Only update if this is the normal price now, not a one-off offer.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّث فقط إذا كان هذا هو السعر المعتاد الآن، وليس عرضًا لمرة واحدة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تەنها نوێی بکەرەوە ئەگەر ئەمە ئێستا نرخی ئاسایییە، نەک داشکاندنێکی یەک جار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe ihn nur an, wenn das jetzt der normale Preis ist und kein einmaliges Angebot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne mettez à jour que si c'est désormais le prix normal, pas une offre ponctuelle."
          }
        }
      }
    },
    "Open ChargeCheck › Reports › Export to send it to your accountant.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح ChargeCheck › التقارير › تصدير لإرساله إلى محاسبك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ChargeCheck › ڕاپۆرتەکان › هەناردەکردن بکەرەوە بۆ ناردنی بۆ ژمێریارەکەت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ChargeCheck › Berichte › Exportieren, um ihn an deinen Steuerberater zu schicken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez ChargeCheck › Rapports › Exporter pour l’envoyer à votre comptable."
          }
        }
      }
    },
    "Open ChargeCheck › Suppliers to see what you owe each supplier and record this week's payments.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح ChargeCheck › المورّدون لترى المستحق لكل مورّد وتسجّل مدفوعات هذا الأسبوع."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ChargeCheck › دابینکەرەکان بکەرەوە بۆ بینینی قەرزی هەر دابینکەرێک و تۆمارکردنی پارەدانەکانی ئەم هەفتەیە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ChargeCheck › Lieferanten, um zu sehen, was du jedem schuldest, und die Zahlungen dieser Woche einzutragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez ChargeCheck › Fournisseurs pour voir ce que vous devez à chacun et enregistrer les paiements de la semaine."
          }
        }
      }
    },
    "Open a spreadsheet or text file (CSV)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح جدول بيانات أو ملفًا نصيًا (CSV)"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "خشتە یان فایلی دەق بکەرەوە (CSV)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabelle oder Textdatei öffnen (CSV)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir un tableur ou un fichier texte (CSV)"
          }
        }
      }
    },
    "Open a supplier and set “Pay within” to see when each of their invoices is due.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح موردًا واضبط «الدفع خلال» لترى متى تستحق كل فاتورة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دابینکەرێک بکەرەوە و «پارەدان لە ماوەی» دابنێ بۆ ئەوەی ببینیت هەر پسوولەیەک کەی دەبێت بدرێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne einen Lieferanten und lege „Zahlbar innerhalb“ fest, um zu sehen, wann jede Rechnung fällig ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un fournisseur et réglez « Payer sous » pour voir l'échéance de chaque facture."
          }
        }
      }
    },
    "Open the app to see what you owe your suppliers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح التطبيق لترى ما تدين به لمورديك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بەرنامەکە بکەرەوە بۆ بینینی قەرزەکانت بۆ دابینکەران."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die App, um zu sehen, was du deinen Lieferanten schuldest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l'app pour voir ce que vous devez à vos fournisseurs."
          }
        }
