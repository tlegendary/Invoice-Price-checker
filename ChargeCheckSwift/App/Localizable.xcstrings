    "ChargeCheck pays for itself by finding money you would otherwise lose.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدفع ChargeCheck ثمنه بنفسه بإيجاد المال الذي كنت ستخسره."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ChargeCheck پارەی خۆی دەداتەوە بە دۆزینەوەی ئەو پارەیەی کە ئەگینا لەدەستت دەدا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ChargeCheck bezahlt sich selbst, indem es Geld findet, das du sonst verlieren würdest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ChargeCheck se rembourse en trouvant l'argent que vous perdriez sinon."
          }
        }
      }
    },
    "ChargeCheck reads the statement and ticks it off against %@'s invoices and your payments. It doesn't use a scan.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ ChargeCheck الكشف ويطابقه مع فواتير %@ ومدفوعاتك. لا يستهلك مسحًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ChargeCheck کەشفەکە دەخوێنێتەوە و لەگەڵ پسوولەکانی %@ و پارەدانەکانت بەراوردی دەکات. هیچ سکانێک بەکارناهێنێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ChargeCheck liest den Kontoauszug und gleicht ihn mit den Rechnungen von %@ und deinen Zahlungen ab. Dafür wird kein Scan verbraucht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ChargeCheck lit le relevé et le compare aux factures de %@ et à vos paiements. Cela n’utilise pas de scan."
          }
        }
      }
    },
