    "%@ invoice %@ of %@ for %@ is already saved.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فاتورة %1$@ رقم %2$@ بتاريخ %3$@ بمبلغ %4$@ محفوظة مسبقًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پسوولەی %1$@ ژمارە %2$@ بە ڕێکەوتی %3$@ بە بڕی %4$@ پێشتر پاشەکەوت کراوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Rechnung %2$@ von %1$@ vom %3$@ über %4$@ ist schon gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La facture %2$@ de %1$@ du %3$@ de %4$@ est déjà enregistrée."
          }
        }
      }
    },
    "%@ invoice of %@ for %@ is already saved.": {
