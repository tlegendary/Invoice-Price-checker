    "Your month in plain words: what you spent, who overcharged, what went up.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شهرك بكلمات بسيطة: ما صرفته، ومن بالغ في السعر، وما ارتفع."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "مانگەکەت بە زمانێکی سادە: چیت خەرج کرد، کێ نرخی زیادەی وەرگرت، چی گران بوو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Monat in einfachen Worten: was du ausgegeben hast, wer zu viel berechnet hat, was teurer wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
