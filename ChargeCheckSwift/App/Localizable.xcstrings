    "New invoices are filed under %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُسجَّل الفواتير الجديدة باسم %@."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پسوولە نوێیەکان دەخرێنە سەر %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Rechnungen werden unter %@ abgelegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles factures sont classées dans %@."
          }
        }
      }
    },
    "New invoices are filed under the ticked shop. Swipe a shop to rename or remove it; its invoices stay in Reports.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ الفواتير الجديدة تحت المتجر المحدد. اسحب على متجر لإعادة تسميته أو إزالته؛ تبقى فواتيره في التقارير."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پسوولە نوێیەکان لەژێر ئەو دوکانەی نیشانەی لەسەرە هەڵدەگیرێن. دوکانێک ڕابکێشە بۆ گۆڕینی ناوی یان لابردنی؛ پسوولەکانی لە ڕاپۆرتەکاندا دەمێننەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Rechnungen werden unter der markierten Filiale abgelegt. Wische über eine Filiale, um sie umzubenennen oder zu entfernen; ihre Rechnungen bleiben in den Berichten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles factures sont classées sous le magasin coché. Balayez un magasin pour le renommer ou le retirer ; ses factures restent dans les rapports."
          }
        }
      }
    },
    "New items are added at the price on this invoice, so you'll be told if it goes up next time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضاف الأصناف الجديدة بسعر هذه الفاتورة، لتُنبَّه إذا ارتفع السعر في المرة القادمة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کاڵا نوێیەکان بە نرخی ئەم پسوولەیە زیاد دەکرێن، بۆ ئەوەی ئاگادار بکرێیتەوە ئەگەر جاری داهاتوو بەرز بووەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Artikel werden mit dem Preis dieser Rechnung angelegt, damit du benachrichtigt wirst, wenn er beim nächsten Mal steigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux articles sont ajoutés au prix de cette facture, pour être prévenu s’il augmente la prochaine fois."
          }
        }
      }
    },
