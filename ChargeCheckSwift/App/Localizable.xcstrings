    "Your price for %@ was lowered from %@ to %@, the cheaper price on this invoice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخفيض سعرك لـ %@ من %@ إلى %@، وهو السعر الأرخص في هذه الفاتورة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نرخەکەت بۆ %@ لە %@ ەوە دابەزێنرا بۆ %@، کە نرخە هەرزانترەکەی ئەم پسوولەیەیە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Preis für %@ wurde von %@ auf %@ gesenkt, den günstigeren Preis dieser Rechnung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre prix pour %@ est passé de %@ à %@, le prix moins cher de cette facture."
          }
        }
      }
    },
    "Your prices and this supplier's special prices are kept.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى أسعارك والأسعار الخاصة بهذا المورّد."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نرخەکانت و نرخە تایبەتەکانی ئەم دابینکەرە دەمێننەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Preise und die Sonderpreise dieses Lieferanten bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos prix et les prix spéciaux de ce fournisseur sont conservés."
          }
        }
      }
    },
    "Your prices are here": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسعارك هنا"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نرخەکانت لێرەن"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Preise sind da"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos prix sont là"
          }
        }
      }
    },
    "Your purchase is waiting for approval. It will be added as soon as it's approved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية الشراء بانتظار الموافقة. ستُضاف فور الموافقة عليها."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کڕینەکەت چاوەڕێی ڕەزامەندییە. هەر کە ڕەزامەندی درا زیاد دەکرێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Genehmigung. Er wird hinzugefügt, sobald er genehmigt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat attend une approbation. Il sera ajouté dès qu’il sera approuvé."
          }
        }
      }
    },
    "Your purchase is waiting for approval. The scans will be added as soon as it's approved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية الشراء بانتظار الموافقة. ستُضاف عمليات المسح فور الموافقة عليها."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کڕینەکەت چاوەڕێی ڕەزامەندییە. هەر کە ڕەزامەندی درا سکانەکان زیاد دەکرێن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Genehmigung. Die Scans werden hinzugefügt, sobald er genehmigt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat attend une approbation. Les scans seront ajoutés dès qu’il sera approuvé."
          }
        }
      }
    },
    "Your reports are kept. Deleted prices can be brought back from More › Recently deleted for 30 days.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ تقاريرك. يمكن استعادة الأسعار المحذوفة من المزيد › المحذوفة مؤخرًا خلال 30 يومًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ڕاپۆرتەکانت دەمێننەوە. نرخە سڕاوەکان تا 30 ڕۆژ لە زیاتر › تازە سڕاوەکان دەگەڕێنرێنەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Berichte bleiben erhalten. Gelöschte Preise lassen sich 30 Tage lang unter Mehr › Zuletzt gelöscht zurückholen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos rapports sont conservés. Les prix supprimés peuvent être récupérés pendant 30 jours dans Plus › Supprimés récemment."
          }
        }
      }
    },
    "Your reports are kept. This can't be undone, so save a backup first in Settings.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستبقى تقاريرك. لا يمكن التراجع عن هذا، لذا احفظ نسخة احتياطية أولًا من الإعدادات."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ڕاپۆرتەکانت دەمێننەوە. ئەمە ناگەڕێتەوە، بۆیە سەرەتا لە ڕێکخستنەکاندا باکئەپێک هەڵبگرە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Berichte bleiben erhalten. Das kann nicht rückgängig gemacht werden, also sichere vorher ein Backup in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos rapports sont conservés. C’est irréversible, alors faites d’abord une sauvegarde dans Réglages."
          }
        }
      }
    },
    "Your saved data couldn't be opened, so nothing can be restored now. Close ChargeCheck and open it again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح بياناتك المحفوظة، لذلك لا يمكن استعادة أي شيء الآن. أغلق ChargeCheck وافتحه مرة أخرى."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "زانیارییە پاشەکەوتکراوەکانت نەکرانەوە، بۆیە ئێستا هیچ شتێک ناگەڕێندرێتەوە. ChargeCheck دابخە و دووبارە بیکەرەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherten Daten konnten nicht geöffnet werden, deshalb kann jetzt nichts wiederhergestellt werden. Schließe ChargeCheck und öffne es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données enregistrées n'ont pas pu être ouvertes : rien ne peut être restauré pour l'instant. Fermez ChargeCheck et rouvrez-le."
          }
        }
      }
    },
    "Your saved data couldn't be opened, so sharing is paused on this phone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح بياناتك المحفوظة، لذلك أُوقفت المشاركة مؤقتًا على هذا الهاتف."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "زانیارییە پاشەکەوتکراوەکانت نەکرانەوە، بۆیە هاوبەشکردن لەم مۆبایلەدا ڕاگیراوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherten Daten konnten nicht geöffnet werden, deshalb ist das Teilen auf diesem iPhone pausiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données enregistrées n'ont pas pu être ouvertes : le partage est suspendu sur ce téléphone."
          }
        }
      }
    },
    "Your saved data couldn't be opened. Anything you add now won't be kept. Close the app and open it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح بياناتك المحفوظة. لن يُحفظ ما تضيفه الآن. أغلق التطبيق وافتحه من جديد."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "زانیارییە هەڵگیراوەکانت نەکرانەوە. ئەوەی ئێستا زیادی دەکەیت هەڵناگیرێت. ئەپەکە دابخە و دووبارە بیکەرەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherten Daten konnten nicht geöffnet werden. Was du jetzt hinzufügst, wird nicht behalten. Schließe die App und öffne sie erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données enregistrées n’ont pas pu être ouvertes. Ce que vous ajoutez maintenant ne sera pas conservé. Fermez l’app et rouvrez-la."
          }
        }
      }
    },
