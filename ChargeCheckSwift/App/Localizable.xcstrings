    "%@ is %@ on this invoice. Your price is %@. Update your price?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سعر %1$@ في هذه الفاتورة %2$@، وسعرك %3$@. هل تريد تحديث سعرك؟"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نرخی %1$@ لەم پسوولەیەدا %2$@ە. نرخەکەی تۆ %3$@ە. نرخەکەت نوێ بکەیتەوە؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kostet auf dieser Rechnung %2$@. Dein Preis ist %3$@. Deinen Preis anpassen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est à %2$@ sur cette facture. Votre prix est de %3$@. Mettre à jour votre prix ?"
          }
        }
      }
    },
    "%@ per month. Payment is charged to your Apple ID when you confirm.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ شهريًا. يُخصم المبلغ من حساب Apple الخاص بك عند التأكيد."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ مانگانە. پارەکە لە کاتی پشتڕاستکردنەوەدا لە ئەکاونتی Apple ـەکەت دەبڕدرێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro Monat. Die Zahlung wird bei Bestätigung über deine Apple-ID abgerechnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par mois. Le paiement est débité sur votre identifiant Apple lors de la confirmation."
          }
        }
      }
    },
    "%@ per year. Payment is charged to your Apple ID when you confirm.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ سنويًا. يُخصم المبلغ من حساب Apple الخاص بك عند التأكيد."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ساڵانە. پارەکە لە کاتی پشتڕاستکردنەوەدا لە ئەکاونتی Apple ـەکەت دەبڕدرێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro Jahr. Die Zahlung wird bei Bestätigung über deine Apple-ID abgerechnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par an. Le paiement est débité sur votre identifiant Apple lors de la confirmation."
          }
        }
      }
    },
