    "No active subscription was found for this Apple ID.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على اشتراك فعّال لحساب Apple هذا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ بەشداریکردنێکی چالاک بۆ ئەم ئەکاونتی Apple ـە نەدۆزرایەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Apple-ID wurde kein aktives Abo gefunden."
          }
