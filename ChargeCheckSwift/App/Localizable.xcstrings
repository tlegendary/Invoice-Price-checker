          }
        }
      }
    },
    "Apple Intelligence check and a monthly summary in plain words": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فحص Apple Intelligence وملخص شهري بكلمات بسيطة"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پشکنینی Apple Intelligence و پوختەی مانگانە بە زمانێکی سادە"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence-Prüfung und eine Monatsübersicht in einfachen Worten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification Apple Intelligence et un résumé mensuel en mots simples"
          }
        }
      }
    },
    "Apple Intelligence double-checks names and matches on your iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد Apple Intelligence فحص الأسماء والمطابقات على جهازك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ناو و هاوتاکردنەکان لەسەر ئایفۆنەکەت دووبارە دەپشکنێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence prüft Namen und Zuordnungen auf deinem iPhone nach."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence revérifie les noms et correspondances sur votre iPhone."
          }
        }
      }
    },
    "Apple Intelligence is still downloading. It will be used once it's ready.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال Apple Intelligence قيد التنزيل. سيُستخدم عندما يصبح جاهزًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence هێشتا دادەبەزێت. کاتێک ئامادە بوو بەکاردەهێنرێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence wird noch geladen. Sie wird genutzt, sobald sie bereit ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est encore en téléchargement. Elle sera utilisée dès qu’elle sera prête."
          }
        }
      }
    },
    "Apple Intelligence is writing your summary…": {
      "extractionState": "manual",
