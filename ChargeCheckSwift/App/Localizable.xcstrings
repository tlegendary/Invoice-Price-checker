        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "١ پسوولە سکان نەکرا چونکە هیچ سکانێکت نەمابوو. بۆ هەر پسوولەیەک ڕیکلامێک یان سکانێک لە پاکێجێک پێویستە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
