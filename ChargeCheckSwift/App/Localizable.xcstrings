    "I've checked the invoice below against our agreed prices and found the following differences:": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجعت الفاتورة أدناه مقارنةً بأسعارنا المتفق عليها ووجدت الفروقات التالية:"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پسوولەکەی خوارەوەم لەگەڵ نرخە ڕێککەوتووەکانمان بەراورد کرد و ئەم جیاوازیانەم دۆزییەوە:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ich habe die folgende Rechnung mit unseren vereinbarten Preisen verglichen und diese Abweichungen gefunden:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai comparé la facture ci-dessous avec nos prix convenus et trouvé les écarts suivants :"
          }
        }
      }
    },
    "I've checked this line": {
