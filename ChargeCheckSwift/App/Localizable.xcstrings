    "Invoice {1} ({2}, {3}): we don't have this invoice. Please send a copy.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفاتورة {1} ({2}، {3}): ليست لدينا هذه الفاتورة. يرجى إرسال نسخة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پسوولەی {1} ({2}، {3}): ئەم پسوولەیەمان نییە. تکایە کۆپییەک بنێرن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechnung {1} ({2}, {3}): Diese Rechnung liegt uns nicht vor. Bitte senden Sie eine Kopie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facture {1} ({2}, {3}) : nous n’avons pas cette facture. Merci d’en envoyer une copie."
          }
        }
      }
    },
    "Invoice {1}: your statement says {2}, our copy says {3}.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفاتورة {1}: كشفكم يقول {2}، ونسختنا تقول {3}."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پسوولەی {1}: کەشفەکەتان دەڵێت {2}، کۆپییەکەی ئێمە دەڵێت {3}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechnung {1}: Laut Ihrem Kontoauszug {2}, laut unserer Kopie {3}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facture {1} : votre relevé indique {2}, notre copie indique {3}."
          }
        }
      }
    },
