          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivé : %1$@ sur %2$@"
          }
        }
      }
    },
    "Ask me first": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسألني أولًا"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "سەرەتا لێم بپرسە"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst fragen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Me demander d'abord"
          }
        }
      }
    },
    "Ask the supplier to cancel one of them, or delete this one once it's sorted out. It stays under Home › Needs attention until it's paid or the warning is removed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من المورّد إلغاء إحداهما، أو احذف هذه بعد تسوية الأمر. تبقى في الرئيسية › يحتاج إلى انتباه حتى تُدفع أو يُزال التنبيه."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "داوا لە دابینکەر بکە یەکێکیان هەڵبوەشێنێتەوە، یان دوای چارەسەرکردن ئەمە بسڕەوە. لە سەرەکی › پێویستی بە سەرنجە دەمێنێتەوە تا دەدرێت یان ئاگادارکردنەوەکە لادەبرێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte den Lieferanten, eine davon zu stornieren, oder lösche diese, sobald es geklärt ist. Sie bleibt unter Start › Braucht Aufmerksamkeit, bis sie bezahlt oder die Warnung entfernt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez au fournisseur d'en annuler une, ou supprimez celle-ci une fois réglé. Elle reste dans Accueil › À traiter jusqu'à son paiement ou le retrait de l'alerte."
          }
        }
      }
    },
    "Asked for %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم طلب %@"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "داوای %@ کرا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ angefordert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demandé"
          }
        }
      }
    },
    "Asks for Face ID, Touch ID or your passcode each time ChargeCheck opens, so staff or family using this phone can't see your prices and payments.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب بصمة الوجه أو بصمة الإصبع أو رمز الدخول في كل مرة يُفتح فيها ChargeCheck، حتى لا يرى الموظفون أو العائلة أسعارك ومدفوعاتك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەر جارێک ChargeCheck دەکرێتەوە داوای Face ID، Touch ID یان وشەی نهێنی دەکات، بۆ ئەوەی کارمەند یان خێزان نرخ و پارەدانەکانت نەبینن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt bei jedem Öffnen von ChargeCheck nach Face ID, Touch ID oder deinem Code, damit Mitarbeiter oder Familie deine Preise und Zahlungen nicht sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande Face ID, Touch ID ou votre code à chaque ouverture de ChargeCheck, pour que le personnel ou la famille ne voie pas vos prix et paiements."
          }
        }
      }
    },
