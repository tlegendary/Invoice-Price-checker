    "Add your shops first, then move these to the right one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف متاجرك أولًا، ثم انقل هذه إلى المتجر الصحيح."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "سەرەتا دوکانەکانت زیاد بکە، پاشان ئەمانە بگوازەرەوە بۆ دوکانی دروست."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege zuerst deine Filialen an und verschiebe diese dann in die richtige."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d'abord vos magasins, puis déplacez-les dans le bon."
          }
        }
      }
    },
    "Add your shops in Settings › Shops and choose a shop when you scan. Then each shop's figures appear here side by side.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف متاجرك من الإعدادات › المتاجر واختر متجرًا عند المسح. ستظهر أرقام كل متجر هنا جنبًا إلى جنب."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دوکانەکانت لە ڕێکخستنەکان › دوکانەکان زیاد بکە و لە کاتی سکانکردن دوکانێک هەڵبژێرە. ئینجا ژمارەکانی هەر دوکانێک لێرە لە تەنیشت یەک دەردەکەون."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deine Filialen unter Einstellungen › Filialen hinzu und wähle beim Scannen eine Filiale. Dann erscheinen die Zahlen jeder Filiale hier nebeneinander."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez vos magasins dans Réglages › Magasins et choisissez un magasin quand vous scannez. Les chiffres de chaque magasin apparaissent alors ici côte à côte."
          }
        }
      }
    },
