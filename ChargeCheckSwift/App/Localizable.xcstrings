    "Read each photo": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة كل صورة"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "خوێندنەوەی هەر وێنەیەک"
