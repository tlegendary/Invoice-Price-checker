    "Overdue invoices are included. Suppliers who invoice in another currency are listed below but not added in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشمل الفواتير المتأخرة. الموردون بعملة أخرى مذكورون أدناه لكن لا يُجمعون."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پسوولە دواکەوتووەکانیش تێدایە. دابینکەرانی دراوێکی تر لە خوارەوەن بەڵام کۆ ناکرێنەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überfällige Rechnungen sind enthalten. Lieferanten mit anderer Währung stehen unten, werden aber nicht mitgerechnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les factures en retard sont incluses. Les fournisseurs facturant dans une autre devise sont listés ci-dessous mais pas additionnés."
          }
        }
      }
    },
