    "Sign in to iCloud in the Settings app first (Settings › your name › iCloud).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى iCloud أولًا من تطبيق الإعدادات (الإعدادات › اسمك › iCloud)."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "سەرەتا لە ئەپی Settings بچۆ ناو iCloud (Settings › ناوەکەت › iCloud)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich zuerst in der Einstellungen-App bei iCloud an (Einstellungen › dein Name › iCloud)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous d’abord à iCloud dans l’app Réglages (Réglages › votre nom › iCloud)."
          }
        }
      }
    },
    "Sign in to iCloud on this iPhone (Settings › your name › iCloud) and everything is saved there automatically.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى iCloud على هذا الـ iPhone (الإعدادات › اسمك › iCloud) وسيُحفظ كل شيء هناك تلقائيًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لەم iPhoneـە بچۆ ژوورەوەی iCloud (ڕێکخستنەکان › ناوەکەت › iCloud) و هەموو شتێک خۆکارانە لەوێ پاشەکەوت دەکرێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich auf diesem iPhone bei iCloud an (Einstellungen › dein Name › iCloud), dann wird alles automatisch dort gesichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à iCloud sur cet iPhone (Réglages › votre nom › iCloud) et tout y est enregistré automatiquement."
          }
        }
      }
    },
    "Signed out of iCloud. Sharing is paused.": {
      "extractionState": "manual",
