    "Your backup was found in iCloud: %lld prices and %lld invoices.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُثر على نسختك الاحتياطية في iCloud: %lld سعرًا و%lld فاتورة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "باکئەپەکەت لە iCloud دۆزرایەوە: %lld نرخ و %lld پسوولە."
          }
        },
        "de": {
