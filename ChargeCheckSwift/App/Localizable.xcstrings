    "Compared with the last invoice from this supplier, even when it's still within your agreed price.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقارنةً بآخر فاتورة من هذا المورّد، حتى لو كان ضمن سعرك المتفق عليه."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بەراورد بە دوایین پسوولەی ئەم دابینکەرە، تەنانەت ئەگەر هێشتا لە نرخی ڕێککەوتووتدا بێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verglichen mit der letzten Rechnung dieses Lieferanten, auch wenn der Preis noch im vereinbarten Rahmen liegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparé à la dernière facture de ce fournisseur, même si c’est encore dans votre prix convenu."
          }
        }
      }
    },
    "Copied": {
      "localizations": {
        "ar": {
