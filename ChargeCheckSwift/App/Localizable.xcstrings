        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكتوب بخط اليد على هذا البند: «{1}». إذا كان مفقودًا أو أُعيد، حدّد البند كمفقود أو مُرتجع."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
