    "Record a payment": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل دفعة"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تۆمارکردنی پارەدان"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlung eintragen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer un paiement"
          }
        }
      }
    },
    "Record any amount you paid towards the balance; it pays off the oldest invoices first. Or tick the exact invoices a payment covers.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل أي مبلغ دفعته من الرصيد؛ يسدّد أقدم الفواتير أولًا. أو حدّد الفواتير التي تغطيها الدفعة بالضبط."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەر بڕێک کە بۆ باڵانسەکەت داوە تۆمار بکە؛ سەرەتا کۆنترین پسوولەکان دەداتەوە. یان ئەو پسوولانە دیاری بکە کە پارەدانەکە دەیانگرێتەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage jeden Betrag ein, den du auf den Saldo gezahlt hast; er begleicht zuerst die ältesten Rechnungen. Oder hake genau die Rechnungen ab, die eine Zahlung abdeckt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez n’importe quel montant payé sur le solde ; il règle d’abord les factures les plus anciennes. Ou cochez les factures exactes couvertes par un paiement."
          }
        }
      }
    },
    "Record them in the supplier's account if they're right.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّلها في حساب المورّد إن كانت صحيحة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەگەر ڕاستن لە ئەکاونتی دابینکەرەکەدا تۆماریان بکە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage sie im Konto des Lieferanten ein, wenn sie stimmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez-les dans le compte du fournisseur s’ils sont justes."
          }
        }
      }
    },
