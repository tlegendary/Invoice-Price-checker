    "Your invoices aren't backed up to iCloud. Sign in to iCloud on this iPhone, or choose a folder in More › Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فواتيرك غير محفوظة في iCloud. سجّل الدخول إلى iCloud على هذا الـ iPhone، أو اختر مجلدًا من المزيد › الإعدادات."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پسوولەکانت لە iCloud باکئەپ نەکراون. لەم iPhoneـە بچۆ ژوورەوەی iCloud، یان لە زیاتر › ڕێکخستنەکان بوخچەیەک هەڵبژێرە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Rechnungen werden nicht in iCloud gesichert. Melde dich auf diesem iPhone bei iCloud an oder wähle einen Ordner unter Mehr › Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos factures ne sont pas sauvegardées dans iCloud. Connectez-vous à iCloud sur cet iPhone ou choisissez un dossier dans Plus › Réglages."
          }
        }
      }
    },
    "Your invoices not on the statement": {
