    "Invoices from %@ are always for %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فواتير %1$@ دائمًا لـ %2$@."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پسوولەکانی %1$@ هەمیشە بۆ %2$@ن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechnungen von %1$@ sind immer für %2$@."
          }
        },
