    "Mark the credit as asked for, and ChargeCheck reminds you after %lld days if it hasn't arrived.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل أنك طلبت المبلغ المسترد، وسيذكّرك ChargeCheck بعد %lld يومًا إذا لم يصل."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دیاری بکە کە داوای پارە گەڕاوەکەت کردووە، ChargeCheck دوای %lld ڕۆژ بیرت دەخاتەوە ئەگەر نەگەیشت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere die Gutschrift als angefordert – ChargeCheck erinnert dich nach %lld Tagen, falls sie nicht angekommen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez l’avoir comme demandé : ChargeCheck vous le rappellera après %lld jours s’il n’est pas arrivé."
          }
        }
      }
    },
