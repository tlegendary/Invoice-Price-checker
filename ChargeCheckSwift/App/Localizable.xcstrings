    "How much you owe your suppliers, and to whom.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم تدين لمورديك ولمن."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "چەند قەرزداری دابینکەرانتی و بە کێ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel du deinen Lieferanten schuldest und wem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien vous devez à vos fournisseurs, et à qui."
          }
        }
      }
    },
    "How suppliers write this item on their invoices, separated by commas. The app uses these to recognise it.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طريقة كتابة المورّدين لهذا الصنف على فواتيرهم، مفصولة بفواصل. يستخدمها التطبيق للتعرّف عليه."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دابینکەرەکان چۆن ئەم کاڵایە لەسەر پسوولەکانیان دەنووسن، بە کۆما جیاکراوەتەوە. ئەپەکە بۆ ناسینەوەی بەکاریان دەهێنێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So schreiben Lieferanten diesen Artikel auf ihre Rechnungen, durch Kommas getrennt. Die App erkennt ihn daran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment les fournisseurs écrivent cet article sur leurs factures, séparé par des virgules. L’app s’en sert pour le reconnaître."
          }
        }
      }
    },
