          "stringUnit": {
            "state": "translated",
            "value": "أضف الأسعار التي اتفقت عليها مع مورديك. اضغط + لإضافة سعر، أو استخدم قائمة ••• للصق قائمة كاملة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەو نرخانە زیاد بکە کە لەگەڵ دابینکەرەکانت ڕێککەوتوویت. + دابگرە بۆ زیادکردنی یەکێک، یان لیستی ••• بەکاربهێنە بۆ لکاندنی لیستێکی تەواو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Preise hinzu, die du mit deinen Lieferanten vereinbart hast. Tippe auf +, um einen hinzuzufügen, oder nutze das •••-Menü, um eine ganze Liste einzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les prix convenus avec vos fournisseurs. Touchez + pour en ajouter un, ou utilisez le menu ••• pour coller toute une liste."
          }
        }
      }
    },
    "Add your shops": {
      "extractionState": "manual",
      "localizations": {
