          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handschriftlich in dieser Zeile: „{1}“. Wenn der Artikel fehlte oder zurückging, markiere die Zeile als fehlend oder zurückgegeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit à la main sur cette ligne : « {1} ». S’il manquait ou a été renvoyé, marquez la ligne comme manquante ou retournée."
