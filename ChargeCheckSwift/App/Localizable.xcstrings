    "Quantity and price were hard to read – check this line.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان من الصعب قراءة الكمية والسعر – تحقّق من هذا البند."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "خوێندنەوەی بڕ و نرخ قورس بوو – ئەم دێڕە بپشکنە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menge und Preis schwer lesbar – prüfe diese Position."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantité et prix difficiles à lire – vérifiez cette ligne."
          }
        }
      }
    },
    "Quantity was hard to read – worked out {1} from the line total. Check.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان من الصعب قراءة الكمية – تم حسابها {1} من مجموع البند. تحقّق."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "خوێندنەوەی بڕەکە قورس بوو – {1} لە کۆی دێڕەکەوە دەرهێنرا. بیپشکنە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menge schwer lesbar – {1} aus der Positionssumme berechnet. Bitte prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantité difficile à lire – {1} calculé depuis le total de la ligne. À vérifier."
          }
        }
      }
    },
    "Re-check items that already have a category": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد فحص الأصناف التي لها فئة بالفعل"
          }
        },
        "ckb": {
          "stringUnit": {
