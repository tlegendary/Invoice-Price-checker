    "Opens ChargeCheck with the camera, ready to scan a supplier invoice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح ChargeCheck مع الكاميرا، جاهزًا لمسح فاتورة مورّد."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ChargeCheck لەگەڵ کامێرا دەکاتەوە، ئامادە بۆ سکانکردنی پسوولەی دابینکەر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet ChargeCheck mit der Kamera, bereit zum Scannen einer Lieferantenrechnung."
          }
        },
        "fr": {
