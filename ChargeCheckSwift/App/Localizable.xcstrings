    "Suppliers": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المورّدون"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دابینکەرەکان"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lieferanten"
