          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئاگادارکردنەوەکان بۆ ChargeCheck کوژاونەتەوە. لە ئەپی Settings هەڵیانبکە بۆ وەرگرتنی بیرخەرەوەکە."
          }
        },
        "de": {
          "stringUnit": {
