    "I've checked your statement against our records and found these differences:": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجعت كشف حسابكم مقارنةً بسجلاتنا ووجدت هذه الفروقات:"
