    "Items another supplier sells you for less, and what switching would save a month.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصناف يبيعها مورد آخر بسعر أقل، وما يوفره التبديل شهريًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەو کاڵایانەی دابینکەرێکی تر هەرزانتر دەیانفرۆشێت، و گۆڕین مانگانە چەند پاشەکەوت دەکات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Artikel, die ein anderer Lieferant günstiger verkauft, und was ein Wechsel pro Monat sparen würde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Articles qu'un autre fournisseur vend moins cher, et ce qu'un changement ferait économiser par mois."
          }
        }
      }
    },
    "Its items and its supplier both belong to %@.": {
      "extractionState": "manual",
