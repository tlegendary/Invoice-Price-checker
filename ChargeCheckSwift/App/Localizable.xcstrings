    "Open the invite link again and follow Apple's steps to verify.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح رابط الدعوة مرة أخرى واتبع خطوات Apple للتحقق."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بەستەری بانگهێشتەکە دووبارە بکەرەوە و هەنگاوەکانی Apple بۆ پشتڕاستکردنەوە بکە."
          }
        },
        "de": {
