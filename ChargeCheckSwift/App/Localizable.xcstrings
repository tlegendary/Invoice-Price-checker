    "One file couldn't be opened.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح ملف واحد."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "فایلێک نەکرایەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Datei konnte nicht geöffnet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier n’a pas pu être ouvert."
          }
        }
      }
    },
    "One item per line with its price at the end, for example: Chicken wings 10kg %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صنف واحد في كل سطر والسعر في آخره، مثلًا: أجنحة دجاج ١٠ كغ %@"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەر کاڵایەک لە دێڕێکدا و نرخەکەی لە کۆتاییدا، بۆ نموونە: باڵی مریشک ١٠ کگم %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Artikel pro Zeile mit dem Preis am Ende, zum Beispiel: Hähnchenflügel 10 kg %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un article par ligne avec son prix à la fin, par exemple : Ailes de poulet 10 kg %@"
          }
        }
      }
    },
    "One photo couldn't be opened.": {
      "localizations": {
