          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourriez-vous émettre un avoir de ce montant ?"
          }
        }
      }
    },
    "Plus %@ VAT on top. Every line double-checked.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة إلى %@ ضريبة. تم فحص كل بند مرتين."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "سەرەڕای %@ باج. هەموو دێڕێک دوو جار پشکنرا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dazu %@ MwSt. Jede Position doppelt geprüft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus %@ de TVA. Chaque ligne vérifiée deux fois."
          }
        }
      }
    },
    "Possibly %@ more on unsure matches. It only counts once you confirm the item.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما %@ إضافية على مطابقات غير مؤكدة. لا تُحتسب إلا بعد تأكيد الصنف."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لەوانەیە %@ زیاتر لەسەر هاوتاکردنە نادڵنیاکان. تەنها دوای پشتڕاستکردنەوەی کاڵاکە دەژمێردرێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möglicherweise %@ mehr bei unsicheren Zuordnungen. Es zählt erst, wenn du den Artikel bestätigst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut-être %@ de plus sur des correspondances incertaines. Cela ne compte qu'une fois l'article confirmé."
          }
        }
      }
    },
