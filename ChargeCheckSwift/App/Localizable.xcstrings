    },
    "%@ is %@ cheaper than %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ أرخص بـ %2$@ من %3$@"
          }
