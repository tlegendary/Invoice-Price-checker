    "Choose the language your supplier invoices are written in. To change the language of the app itself, tap App language and choose Language.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر اللغة المكتوبة بها فواتير مورديك. لتغيير لغة التطبيق نفسه، اضغط «لغة التطبيق» ثم اختر «اللغة»."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەو زمانە هەڵبژێرە کە پسوولەکانی دابینکەرەکانتی پێ نووسراوە. بۆ گۆڕینی زمانی خودی ئەپەکە، «زمانی ئەپ» دابگرە و «Language» هەڵبژێرە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Sprache, in der deine Lieferantenrechnungen geschrieben sind. Um die Sprache der App selbst zu ändern, tippe auf „App-Sprache“ und wähle „Sprache“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la langue de vos factures fournisseurs. Pour changer la langue de l’app, touchez « Langue de l’app » puis « Langue »."
          }
        }
      }
    },
    "Choose “All shops” at the top to see every invoice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر «كل المتاجر» في الأعلى لرؤية كل الفواتير."
