          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci,"
          }
        }
      }
    },
    "That folder couldn't be used. Please choose another one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استخدام هذا المجلد. يرجى اختيار مجلد آخر."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ناتوانرێت ئەو فۆڵدەرە بەکاربهێنرێت. تکایە یەکێکی تر هەڵبژێرە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner kann nicht verwendet werden. Bitte wähle einen anderen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier ne peut pas être utilisé. Choisissez-en un autre."
          }
        }
      }
    },
    "That invoice couldn't be read, so your scan was given back.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة هذه الفاتورة، لذلك أُعيد إليك المسح."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەو پسوولەیە نەخوێندرایەوە، بۆیە سکانەکەت بۆ گەڕێنرایەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Rechnung konnte nicht gelesen werden, daher hast du deinen Scan zurückbekommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette facture n’a pas pu être lue, votre scan vous a donc été rendu."
          }
        }
      }
    },
    "That isn't a ChargeCheck backup file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس ملف نسخة احتياطية من ChargeCheck."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەمە فایلی باکئەپی ChargeCheck نییە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine ChargeCheck-Backup-Datei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un fichier de sauvegarde ChargeCheck."
          }
        }
      }
    },
    "The App Store couldn't verify this purchase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على App Store التحقق من عملية الشراء هذه."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store نەیتوانی ئەم کڕینە پشتڕاست بکاتەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store konnte diesen Kauf nicht bestätigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store n’a pas pu vérifier cet achat."
          }
        }
      }
    },
    "The ad was closed before the end, so no scan was added.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُغلق الإعلان قبل نهايته، لذلك لم تتم إضافة مسح."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ڕیکلامەکە پێش کۆتایی داخرا، بۆیە هیچ سکانێک زیاد نەکرا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werbung wurde vor dem Ende geschlossen, daher wurde kein Scan hinzugefügt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pub a été fermée avant la fin, aucun scan n’a donc été ajouté."
          }
        }
      }
    },
    "The backup couldn't be made. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إنشاء النسخة الاحتياطية. يرجى المحاولة مجددًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "باکئەپەکە دروست نەکرا. تکایە دووبارە هەوڵ بدەرەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup konnte nicht erstellt werden. Bitte versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde n’a pas pu être créée. Veuillez réessayer."
          }
        }
      }
    },
    "The backup couldn't be saved. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ النسخة الاحتياطية. يرجى المحاولة مجددًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "باکئەپەکە هەڵنەگیرا. تکایە دووبارە هەوڵ بدەرەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup konnte nicht gesichert werden. Bitte versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde n’a pas pu être enregistrée. Veuillez réessayer."
          }
        }
      }
    },
    "The copy of the original invoice in the Files app is kept.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستبقى نسخة الفاتورة الأصلية في تطبيق الملفات."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کۆپیی پسوولەی ڕەسەن لە ئەپی Files دەمێنێتەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie der Originalrechnung in der Dateien-App bleibt erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie de la facture d’origine dans l’app Fichiers est conservée."
          }
        }
      }
    },
    "The figures": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأرقام"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ژمارەکان"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chiffres"
          }
        }
      }
    },
    "The file couldn't be made. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إنشاء الملف. يرجى المحاولة مجددًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "فایلەکە دروست نەکرا. تکایە دووبارە هەوڵ بدەرەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht erstellt werden. Bitte versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n’a pas pu être créé. Veuillez réessayer."
          }
        }
      }
    },
    "The free version gives you one scan for each ad you watch to the end.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمنحك النسخة المجانية مسحًا واحدًا مقابل كل إعلان تشاهده حتى النهاية."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وەشانی بەخۆڕایی بۆ هەر ڕیکلامێک کە تا کۆتایی سەیری دەکەیت سکانێکت پێدەدات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Gratisversion bekommst du für jede bis zum Ende angesehene Werbung einen Scan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite vous donne un scan pour chaque pub regardée jusqu’au bout."
          }
        }
      }
    },
    "The free version lists the last 30 days. Your balances still count every invoice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض النسخة المجانية آخر 30 يومًا. أرصدتك تحسب كل الفواتير."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وەشانی بەخۆڕایی 30 ڕۆژی کۆتایی پیشان دەدات. باڵانسەکانت هێشتا هەموو پسوولەکان دەژمێرن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlose Version zeigt die letzten 30 Tage. Deine Kontostände zählen trotzdem jede Rechnung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite affiche les 30 derniers jours. Vos soldes comptent toujours toutes les factures."
          }
        }
      }
    },
    "The free version shows the last 30 days. Any scan pack keeps every invoice, for good.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض النسخة المجانية آخر 30 يومًا. أي باقة مسح تحفظ كل الفواتير إلى الأبد."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وەشانی بەخۆڕایی 30 ڕۆژی کۆتایی پیشان دەدات. هەر پاکێجێکی سکان هەموو پسوولەکان بە یەکجاری دەهێڵێتەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlose Version zeigt die letzten 30 Tage. Jedes Scan-Paket behält dauerhaft jede Rechnung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite affiche les 30 derniers jours. Tout pack de scans garde chaque facture, définitivement."
          }
        }
      }
    },
    "The invoice says {1} but your item is {2} – check it's the same pack size.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفاتورة تذكر {1} لكن الصنف في قائمتك {2} – تأكد أنه نفس حجم العبوة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پسوولەکە دەڵێت {1} بەڵام کاڵاکەی لیستەکەت {2} ە – دڵنیابە هەمان قەبارەی پاکەتە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Rechnung steht {1}, dein Artikel ist aber {2} – prüfe, ob es dieselbe Packungsgröße ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La facture indique {1} mais votre article est {2} – vérifiez que c’est le même conditionnement."
          }
        }
      }
    },
    "The items below were charged above our agreed prices, or were missing or returned. Please issue a credit note for the amount shown.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأصناف أدناه فُرضت بأسعار أعلى من أسعارنا المتفق عليها، أو كانت ناقصة أو مرتجعة. يرجى إصدار إشعار دائن بالمبلغ المبيّن."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم کاڵایانەی خوارەوە لە سەروو نرخە ڕێککەوتووەکانمانەوە نرخیان لێ وەرگیراوە، یان ون بوون یان گەڕێنراونەتەوە. تکایە بە بڕی دیاریکراو پسوولەی گەڕاندنەوەی پارە دەربکەن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die folgenden Artikel wurden über unseren vereinbarten Preisen berechnet oder fehlten bzw. wurden zurückgegeben. Bitte stellen Sie eine Gutschrift über den angegebenen Betrag aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les articles ci-dessous ont été facturés au-dessus de nos prix convenus, ou étaient manquants ou retournés. Merci d’émettre un avoir du montant indiqué."
          }
        }
      }
    },
    "The lines add up to %@ but the invoice says %@. A line may be missing or misread.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجموع البنود %@ لكن الفاتورة تقول %@. قد يكون هناك بند ناقص أو مقروء بشكل خاطئ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دێڕەکان دەکەنە %@ بەڵام پسوولەکە دەڵێت %@. لەوانەیە دێڕێک ون بێت یان بە هەڵە خوێندرابێتەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Positionen ergeben %@, aber auf der Rechnung steht %@. Eine Position fehlt oder wurde falsch gelesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes font %@ mais la facture indique %@. Une ligne manque peut-être ou a été mal lue."
          }
        }
      }
    },
    "The name is shown at the top of reports and credit requests.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر الاسم أعلى التقارير وطلبات الإشعار الدائن."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ناوەکە لە سەرەوەی ڕاپۆرت و داواکاری گەڕاندنەوەکان دەردەکەوێت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name steht oben auf Berichten und Gutschriftanforderungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom figure en haut des rapports et des demandes d'avoir."
          }
        }
      }
    },
    "The name is shown at the top of reports and credit requests. Add your shops if you have more than one.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر الاسم في أعلى التقارير وطلبات الإشعار الدائن. أضف متاجرك إذا كان لديك أكثر من متجر."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ناوەکە لە سەرەوەی ڕاپۆرت و داواکارییەکانی گەڕاندنەوەی پارە پیشان دەدرێت. ئەگەر زیاتر لە یەک دوکانت هەیە، دوکانەکانت زیاد بکە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name steht oben auf Berichten und Gutschriftanfragen. Füge deine Filialen hinzu, wenn du mehr als eine hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom apparaît en haut des rapports et des demandes d’avoir. Ajoutez vos magasins si vous en avez plusieurs."
          }
        }
      }
    },
    "The owner stopped sharing with this phone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف المالك المشاركة مع هذا الهاتف."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "خاوەنەکە هاوبەشی لەگەڵ ئەم مۆبایلە ڕاگرت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhaber teilt nicht mehr mit diesem iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le propriétaire a arrêté le partage avec ce téléphone."
          }
        }
      }
    },
    "The owner's iCloud storage is full.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة iCloud لدى المالك ممتلئة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بیرگەی iCloud ـی خاوەنەکە پڕە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der iCloud-Speicher des Inhabers ist voll."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage iCloud du propriétaire est plein."
          }
        }
      }
    },
    "The owner's prices and reports are removed from this phone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُزال أسعار المالك وتقاريره من هذا الهاتف."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نرخ و ڕاپۆرتەکانی خاوەنەکە لەم مۆبایلە لادەبرێن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Preise und Berichte des Inhabers werden von diesem iPhone entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix et rapports du propriétaire sont retirés de ce téléphone."
          }
        }
      }
    },
    "The photo looks blurry. Hold the phone still and let it focus before taking the photo, or add the lines by hand.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة غير واضحة. ثبّت الهاتف وانتظر حتى يضبط التركيز قبل التصوير، أو أضف البنود يدويًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وێنەکە ناڕوونە. مۆبایلەکە ڕاگرە و با فۆکەس بکات پێش ئەوەی وێنە بگریت، یان دێڕەکان بە دەست زیاد بکە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto ist unscharf. Halte das Handy ruhig und lass es scharf stellen, bevor du fotografierst, oder füge die Positionen von Hand hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo est floue. Tenez le téléphone immobile et laissez-le faire la mise au point avant de prendre la photo, ou ajoutez les lignes à la main."
          }
        }
      }
    },
    "The photo looks too dark to read. Take it again in brighter light or with the flash, or add the lines by hand.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة مظلمة جدًا ولا يمكن قراءتها. أعد التصوير في إضاءة أقوى أو باستخدام الفلاش، أو أضف البنود يدويًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وێنەکە زۆر تاریکە و ناخوێندرێتەوە. لە ڕووناکییەکی زیاتردا یان بە فلاش دووبارە بیگرەوە، یان دێڕەکان بە دەست زیاد بکە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto ist zu dunkel zum Lesen. Fotografiere es bei mehr Licht oder mit Blitz noch einmal oder füge die Positionen von Hand hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo est trop sombre pour être lue. Reprenez-la avec plus de lumière ou avec le flash, ou ajoutez les lignes à la main."
          }
        }
      }
    },
    "The plans couldn't be loaded from the App Store. Check your internet connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل الخطط من App Store. تحقّق من اتصالك بالإنترنت وحاول مجددًا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پلانەکان لە App Store بار نەکران. پەیوەندیی ئینتەرنێتەکەت بپشکنە و دووبارە هەوڵ بدەرەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tarife konnten nicht aus dem App Store geladen werden. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les formules n’ont pas pu être chargées depuis l’App Store. Vérifiez votre connexion Internet et réessayez."
          }
        }
      }
    },
    "The purchase didn't finish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكتمل عملية الشراء."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کڕینەکە تەواو نەبوو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wurde nicht abgeschlossen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat n’a pas abouti."
          }
        }
      }
    },
    "The purchase didn't go through. %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تنجح عملية الشراء. %@"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کڕینەکە سەرکەوتوو نەبوو. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf hat nicht geklappt. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat n’a pas fonctionné. %@"
          }
        }
      }
    },
    "The sample invoice is missing from the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفاتورة النموذجية غير موجودة في التطبيق."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پسوولەی نموونە لە ئەپەکەدا نییە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beispielrechnung fehlt in der App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La facture exemple manque dans l’app."
          }
        }
      }
    },
    "The second read gave %@ × %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعطت القراءة الثانية %@ × %@."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "خوێندنەوەی دووەم %@ × %@ ی دا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das zweite Lesen ergab %@ × %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La deuxième lecture a donné %@ × %@."
          }
        }
      }
    },
    "The supplier billed me twice – keep both": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المورّد أصدر الفاتورة مرتين – احتفظ بالاثنتين"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دابینکەر دوو جار پسوولەی بۆ ناردووم – هەردووکیان بهێڵەوە"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Lieferant hat doppelt abgerechnet – beide behalten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a facturé deux fois – garder les deux"
          }
        }
      }
    },
    "The supplier billed this invoice twice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصدر المورّد هذه الفاتورة مرتين"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دابینکەر ئەم پسوولەیەی دوو جار ناردووە"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Lieferant hat diese Rechnung doppelt gestellt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a facturé cette facture deux fois"
          }
        }
      }
    },
    "The two reads of the photo didn't agree on this line.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القراءتان للصورة لم تتطابقا في هذا البند."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دوو خوێندنەوەکەی وێنەکە لەسەر ئەم دێڕە یەکیان نەگرتەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die beiden Lesevorgänge des Fotos stimmen bei dieser Position nicht überein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux lectures de la photo ne concordent pas sur cette ligne."
          }
        }
      }
    },
    "The widget is part of Pro. Open ChargeCheck to see the plans.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأداة جزء من Pro. افتح ChargeCheck لرؤية الخطط."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ویجێتەکە بەشێکە لە Pro. ChargeCheck بکەرەوە بۆ بینینی پلانەکان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Widget gehört zu Pro. Öffne ChargeCheck, um die Pläne zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le widget fait partie de Pro. Ouvrez ChargeCheck pour voir les formules."
          }
        }
      }
    },
    "These invoices have no VAT": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد ضريبة على هذه الفواتير"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم پسوولانە VAT یان نییە"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Rechnungen enthalten keine MwSt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces factures n’ont pas de TVA"
          }
        }
      }
    },
    "These were saved before every line was matched to your prices. Open one to see its lines.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُفظت هذه قبل مطابقة كل سطر بأسعارك. افتح واحدة لترى سطورها."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەمانە پاشەکەوت کران پێش ئەوەی هەموو هێڵێک بە نرخەکانت هاوتا بکرێت. یەکێکیان بکەرەوە بۆ بینینی هێڵەکانی."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese wurden gespeichert, bevor jede Zeile deinen Preisen zugeordnet war. Öffne eine, um die Zeilen zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles ont été enregistrées avant que chaque ligne soit associée à vos prix. Ouvrez-en une pour voir ses lignes."
          }
        }
      }
    },
    "They say you owe": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقولون إنك مدين بـ"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەوان دەڵێن قەرزاریت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laut Lieferant schuldest du"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon eux, vous devez"
          }
        }
      }
    },
    "They stay in More › Recently deleted for 30 days, so you can bring them back. Deleting the payments too starts this supplier's balance from zero.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى في المزيد › المحذوفة مؤخرًا 30 يومًا لتتمكن من استعادتها. حذف الدفعات أيضًا يبدأ رصيد هذا المورد من الصفر."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "30 ڕۆژ لە زیاتر › تازە سڕاوەکان دەمێننەوە بۆ ئەوەی بیانگەڕێنیتەوە. سڕینەوەی پارەدانەکانیش باڵانسی ئەم دابینکەرە لە سفرەوە دەست پێدەکاتەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie bleiben 30 Tage unter Mehr › Zuletzt gelöscht, damit du sie zurückholen kannst. Werden auch die Zahlungen gelöscht, beginnt der Kontostand dieses Lieferanten bei null."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles restent 30 jours dans Plus › Supprimés récemment pour pouvoir les récupérer. Supprimer aussi les paiements remet le solde de ce fournisseur à zéro."
          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن ذلك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەمە ناگەڕێتەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible."
          }
        }
      }
    },
    "This can't be undone. Save a backup in Settings first if you might need them. Deleting the payments too starts this supplier's balance from zero.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن هذا. احفظ نسخة احتياطية من الإعدادات أولًا إن كنت قد تحتاجها. حذف المدفوعات أيضًا يبدأ رصيد هذا المورّد من الصفر."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەمە ناگەڕێتەوە. ئەگەر لەوانەیە پێویستت پێیان بێت، سەرەتا لە ڕێکخستنەکان باکئەپێک هەڵبگرە. سڕینەوەی پارەدانەکانیش باڵانسی ئەم دابینکەرە لە سفرەوە دەست پێدەکاتەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann nicht rückgängig gemacht werden. Sichere vorher ein Backup in den Einstellungen, falls du sie noch brauchst. Werden auch die Zahlungen gelöscht, beginnt der Saldo dieses Lieferanten bei null."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est irréversible. Faites d’abord une sauvegarde dans Réglages si vous pourriez en avoir besoin. Supprimer aussi les paiements remet le solde de ce fournisseur à zéro."
          }
        }
      }
    },
    "This iPhone doesn't support Apple Intelligence (it needs an iPhone 15 Pro or newer).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز iPhone هذا لا يدعم Apple Intelligence (يحتاج إلى iPhone 15 Pro أو أحدث)."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم iPhone ـە پشتگیریی Apple Intelligence ناکات (پێویستی بە iPhone 15 Pro یان نوێترە)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone unterstützt Apple Intelligence nicht (es braucht ein iPhone 15 Pro oder neuer)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone ne prend pas en charge Apple Intelligence (il faut un iPhone 15 Pro ou plus récent)."
          }
        }
      }
    },
    "This invoice is in %@, but your prices are in %@. Check the prices before saving, or change the currency in Settings.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الفاتورة بعملة %1$@، لكن أسعارك بعملة %2$@. تحقق من الأسعار قبل الحفظ أو غيّر العملة من الإعدادات."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم پسوولەیە بە %1$@ە، بەڵام نرخەکانت بە %2$@ن. پێش پاشەکەوت نرخەکان بپشکنە، یان دراو لە ڕێکخستنەکان بگۆڕە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Rechnung ist in %1$@, deine Preise sind in %2$@. Prüfe die Preise vor dem Speichern oder ändere die Währung in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette facture est en %1$@, mais vos prix sont en %2$@. Vérifiez les prix avant d’enregistrer, ou changez la devise dans Réglages."
          }
        }
      }
    },
    "This invoice is in %@, but your prices are in %@. Check the prices before saving, or set this supplier to %@ in Suppliers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الفاتورة بعملة %1$@، لكن أسعارك بعملة %2$@. تحقق من الأسعار قبل الحفظ، أو اضبط هذا المورد على %3$@ في الموردين."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم پسوولەیە بە %1$@ـە، بەڵام نرخەکانت بە %2$@ـن. پێش پاشەکەوتکردن نرخەکان بپشکنە، یان لە دابینکەران ئەم دابینکەرە بکە بە %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Rechnung ist in %1$@, deine Preise sind in %2$@. Prüfe die Preise vor dem Speichern oder stelle diesen Lieferanten unter Lieferanten auf %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This invoice is in %1$@, but your prices are in %2$@. Check the prices before saving, or set this supplier to %3$@ in Suppliers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette facture est en %1$@, mais vos prix sont en %2$@. Vérifiez les prix avant d'enregistrer, ou réglez ce fournisseur sur %3$@ dans Fournisseurs."
          }
        }
      }
    },
    "This is a different item": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا صنف مختلف"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەمە کاڵایەکی ترە"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein anderer Artikel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est un autre article"
          }
        }
      }
    },
    "This looks like a delivery note, not an invoice. Check it before saving.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو هذا مذكرة تسليم وليس فاتورة. تحقق منه قبل الحفظ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەمە وەک پسوولەی گەیاندن دیارە، نەک پسوولەی کڕین. پێش پاشەکەوت بیپشکنە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nach einem Lieferschein aus, nicht nach einer Rechnung. Vor dem Speichern prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci ressemble à un bon de livraison, pas à une facture. Vérifiez avant d’enregistrer."
          }
        }
      }
    },
    "This looks like a quote or pro forma, not an invoice. Check it before saving.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو هذا عرض سعر أو فاتورة مبدئية وليس فاتورة. تحقق منه قبل الحفظ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەمە وەک نرخپێدان دیارە، نەک پسوولە. پێش پاشەکەوت بیپشکنە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nach einem Angebot oder einer Proforma aus, nicht nach einer Rechnung. Vor dem Speichern prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci ressemble à un devis ou une pro forma, pas à une facture. Vérifiez avant d’enregistrer."
          }
        }
      }
    },
    "This looks like a statement. Check statements in Suppliers instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو هذا كشف حساب. افحص كشوف الحساب من قسم الموردين."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەمە وەک کەشفی حیساب دیارە. کەشفەکان لە بەشی دابینکەران بپشکنە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nach einem Kontoauszug aus. Kontoauszüge unter Lieferanten prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci ressemble à un relevé. Vérifiez les relevés dans Fournisseurs."
          }
        }
      }
    },
    "This looks like an order, not an invoice. Check it before saving.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو هذا طلبية وليس فاتورة. تحقق منه قبل الحفظ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەمە وەک داواکاری دیارە، نەک پسوولە. پێش پاشەکەوت بیپشکنە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nach einer Bestellung aus, nicht nach einer Rechnung. Vor dem Speichern prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci ressemble à une commande, pas à une facture. Vérifiez avant d’enregistrer."
          }
        }
      }
    },
    "This month": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الشهر"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم مانگە"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Monat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce mois-ci"
          }
        }
      }
    },
    "This phone's data looks empty, so nothing was deleted from iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدو بيانات هذا الهاتف فارغة، لذلك لم يُحذف شيء من iCloud."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "زانیارییەکانی ئەم مۆبایلە بەتاڵ دیارن، بۆیە هیچ شتێک لە iCloud نەسڕایەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten auf diesem iPhone scheinen leer zu sein, deshalb wurde nichts aus iCloud gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de ce téléphone semblent vides, rien n’a donc été supprimé d’iCloud."
          }
        }
      }
    },
    "This tax year": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه السنة الضريبية"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم ساڵی باجە"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Steuerjahr"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet exercice fiscal"
          }
        }
      }
    },
    "This year": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه السنة"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەمساڵ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Jahr"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette année"
          }
        }
      }
    },
    "Tick a shop to see only that shop everywhere – invoices, suppliers, what you owe, payments and reports – and to file new invoices under it. All shops shows everything. Swipe a shop to rename or remove it; its invoices are kept.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر متجرًا لترى هذا المتجر فقط في كل مكان – الفواتير والمورّدين وما تدين به والدفعات والتقارير – ولتُسجَّل الفواتير الجديدة باسمه. «كل المتاجر» يعرض كل شيء. اسحب متجرًا لإعادة تسميته أو حذفه؛ تبقى فواتيره محفوظة."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دوکانێک هەڵبژێرە بۆ ئەوەی لە هەموو شوێنێک تەنها ئەو دوکانە ببینیت – پسوولەکان، دابینکەرەکان، قەرزەکانت، پارەدانەکان و ڕاپۆرتەکان – و پسوولە نوێیەکان بخرێنە سەری. هەموو دوکانەکان هەموو شتێک پیشان دەدات. دوکانێک ڕابکێشە بۆ گۆڕینی ناو یان لابردنی؛ پسوولەکانی دەمێننەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hake eine Filiale an, um überall nur diese Filiale zu sehen – Rechnungen, Lieferanten, offene Beträge, Zahlungen und Berichte – und neue Rechnungen darunter abzulegen. Alle Filialen zeigt alles. Wische über eine Filiale, um sie umzubenennen oder zu entfernen; ihre Rechnungen bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez un magasin pour ne voir que lui partout – factures, fournisseurs, ce que vous devez, paiements et rapports – et y classer les nouvelles factures. Tous les magasins affiche tout. Balayez un magasin pour le renommer ou le supprimer ; ses factures sont conservées."
          }
        }
      }
    },
    "Tick off what arrived. Anything short comes off what you pay and goes into the credit request.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد ما وصل. أي نقص يُخصم مما تدفعه ويُضاف إلى طلب الإشعار الدائن."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەوەی گەیشتووە دیاری بکە. هەر کەموکورییەک لە پارەدانەکەت دەبڕدرێت و دەچێتە ناو داواکاری گەڕاندنەوە."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hake ab, was angekommen ist. Was fehlt, wird von deiner Zahlung abgezogen und kommt in die Gutschriftanfrage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez ce qui est arrivé. Ce qui manque est déduit de votre paiement et ajouté à la demande d’avoir."
          }
        }
      }
    },
    "Tick off what arrived; anything short comes off what you pay.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد ما وصل؛ أي نقص يُخصم مما تدفعه."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەوەی گەیشتووە دیاری بکە؛ هەر کەمییەک لەوەی دەیدەیت کەم دەکرێتەوە."
