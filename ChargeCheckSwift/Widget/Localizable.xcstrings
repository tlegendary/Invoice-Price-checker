    },
    "ChargeCheck Pro": {
      "shouldTranslate": false
    },
    "How much you owe your suppliers, and to whom.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم تدين لمورّديك، ولمن."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "چەند قەرزاری دابینکەرەکانتی، و بۆ کێ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel du deinen Lieferanten schuldest – und wem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien vous devez à vos fournisseurs, et à qui."
          }
        }
      }
    },
    "Nothing to pay": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء للدفع"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ نییە بۆ پارەدان"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu zahlen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à payer"
          }
        }
      }
    },
    "Open the app to see what you owe your suppliers.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح التطبيق لترى المستحق لمورّديك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەپەکە بکەرەوە بۆ بینینی قەرزەکانت بۆ دابینکەرەکان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die App, um zu sehen, was du deinen Lieferanten schuldest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app pour voir ce que vous devez à vos fournisseurs."
          }
        }
      }
    },
    "Owed %@": {
      "extractionState": "manual",
