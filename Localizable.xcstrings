    "Turn it on in settings and sales from the till send their food and drinks here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّله من الإعدادات وسترسل مبيعات الصندوق الطعام والمشروبات إلى هنا."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لە ڕێکخستنەکان هەڵیبکە و فرۆشتنەکانی سندوق خواردن و خواردنەوەکانیان دەنێرنە ئێرە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte sie in den Einstellungen ein, dann schickt die Kasse Speisen und Getränke hierher."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez-la dans les réglages et les ventes de la caisse enverront plats et boissons ici."
          }
        }
      }
    },
    "Turn off to put Reports back in this tab. The till is then in More and on Home." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أطفئه لإعادة التقارير إلى هذا التبويب. يصبح الكاشير عندها في المزيد وفي الرئيسية."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بیکوژێنەرەوە بۆ گەڕاندنەوەی ڕاپۆرتەکان بۆ ئەم تابە. ئەوکات کاشێر لە زیاتر و سەرەکییە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausschalten, um Berichte wieder in diesen Tab zu legen. Die Kasse ist dann unter Mehr und auf Start."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez pour remettre les Rapports dans cet onglet. La caisse est alors dans Plus et sur l'Accueil."
          }
        }
      }
    },
    "Turn off “Till as its own tab” to put Reports back in this tab. The till is then in More and on Home." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أطفئ «الكاشير كتبويب مستقل» لإعادة التقارير إلى هذا التبويب. يصبح الكاشير عندها في المزيد وفي الرئيسية."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«کاشێر وەک تابێکی سەربەخۆ» بکوژێنەرەوە بۆ گەڕاندنەوەی ڕاپۆرتەکان بۆ ئەم تابە. ئەوکات کاشێر لە زیاتر و سەرەکییە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Kasse als eigener Tab“ ausschalten, um Berichte wieder hierher zu legen. Die Kasse ist dann unter Mehr und auf Start."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez « La caisse dans son propre onglet » pour remettre les Rapports ici. La caisse est alors dans Plus et sur l'Accueil."
          }
        }
      }
    },
    "Turn on Apple Intelligence in the Settings app to use this." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل Apple Intelligence من تطبيق الإعدادات لاستخدام هذه الميزة."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence لە ئەپی Settings هەڵبکە بۆ بەکارهێنانی ئەمە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte Apple Intelligence in der Einstellungen-App ein, um das zu nutzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Apple Intelligence dans l’app Réglages pour utiliser cette fonction."
          }
        }
      }
    },
    "Turn on sharing" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغيل المشاركة"
          }
        },
        "ckb" : {
