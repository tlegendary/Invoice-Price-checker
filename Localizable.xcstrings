    "Changes every screen at once, and your reports use your colour. Larger text never goes below your iPhone's own text size setting." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغيّر كل الشاشات دفعة واحدة، وتستخدم تقاريرك لونك. النص الأكبر لا يقل أبدًا عن إعداد حجم النص في الـ iPhone."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هەموو شاشەکان پێکەوە دەگۆڕێت، و ڕاپۆرتەکانت ڕەنگەکەت بەکاردەهێنن. نووسینی گەورەتر هەرگیز لە ڕێکخستنی قەبارەی نووسینی iPhoneەکەت بچووکتر نابێت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert alle Bildschirme auf einmal, und deine Berichte nutzen deine Farbe. Größerer Text wird nie kleiner als die Textgröße deines iPhones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifie tous les écrans d'un coup, et vos rapports utilisent votre couleur. Le texte plus grand ne descend jamais sous la taille de texte de votre iPhone."
          }
        }
      }
    },
