    "The zip holds the PDF, the spreadsheet, bills for Xero and every invoice photo or PDF for the period, ready to email to your accountant." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي ملف zip على PDF وجدول البيانات وفواتير Xero وكل صورة أو PDF للفواتير في الفترة، جاهزًا لإرساله إلى محاسبك."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فایلی zip ـەکە PDF، خشتەکە، پسوولەکانی Xero و هەموو وێنە یان PDFی پسوولەکانی ئەو ماوەیەی تێدایە، ئامادەیە بۆ ناردن بۆ ژمێریارەکەت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zip-Datei enthält das PDF, die Tabelle, Rechnungen für Xero und jedes Rechnungsfoto oder -PDF des Zeitraums, bereit zum Mailen an deine Steuerberatung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le zip contient le PDF, le tableur, les factures pour Xero et chaque photo ou PDF de facture de la période, prêt à envoyer à votre comptable."
          }
        }
      }
    },
