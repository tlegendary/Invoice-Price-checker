    "Secured" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مضمون"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دڵنیاکراوە"
          }
        },
