        }
      }
    },
    "This invoice's lines were read without VAT rates, so the VAT taken off is the invoice's own VAT share (%@)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قُرئت أسطر هذه الفاتورة بدون نسب الضريبة، لذا فالضريبة المخصومة هي حصة الضريبة في الفاتورة نفسها (%@)."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دێڕەکانی ئەم پسوولەیە بێ ڕێژەی باج خوێنرانەوە، بۆیە ئەو باجەی دەبڕدرێت ڕێژەی باجی خودی پسوولەکەیە (%@)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeilen dieser Rechnung wurden ohne MwSt.-Sätze gelesen, daher wird die MwSt. im Verhältnis der Rechnung abgezogen (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lignes de cette facture ont été lues sans taux de TVA : la TVA déduite suit la part de TVA de la facture (%@)."
