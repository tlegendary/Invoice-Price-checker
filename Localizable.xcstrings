    "On account: they take it now and pay later. The till won't let them owe more than this." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على الحساب: يأخذونه الآن ويدفعون لاحقاً. لن يسمح الكاشير بأن يدينوا بأكثر من هذا."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لەسەر حیساب: ئێستا دەیبەن و دواتر پارە دەدەن. کاشێر ڕێگە نادات لەمە زیاتر قەرزار بن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Rechnung: jetzt mitnehmen, später zahlen. Die Kasse lässt nicht mehr offen als diesen Betrag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur compte : ils emportent maintenant et paient plus tard. La caisse ne les laissera pas devoir plus que ce montant."
          }
        }
      }
