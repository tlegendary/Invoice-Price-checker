    "This backup is empty, so nothing was changed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه النسخة الاحتياطية فارغة، لذا لم يتغير شيء."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
