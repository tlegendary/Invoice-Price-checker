    "Photos or PDFs. Read on this phone, works offline, and every invoice is read twice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صور أو ملفات PDF. تُقرأ على هذا الهاتف وتعمل دون إنترنت، وكل فاتورة تُقرأ مرتين."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وێنە یان PDF. لەسەر ئەم مۆبایلە دەخوێندرێتەوە، بێ ئینتەرنێت کار دەکات، و هەموو پسوولەیەک دوو جار دەخوێندرێتەوە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos oder PDFs. Auf diesem iPhone gelesen, funktioniert offline, und jede Rechnung wird zweimal gelesen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos ou PDF. Lus sur ce téléphone, hors ligne, et chaque facture est lue deux fois."
          }
        }
      }
    },
    "Pick ingredients from your price list. Saving makes a new version from now on; sales already made keep the cost they had." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر المكونات من قائمة أسعارك. الحفظ يُنشئ إصداراً جديداً من الآن؛ تحتفظ المبيعات السابقة بتكلفتها."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پێکهاتەکان لە لیستی نرخەکانت هەڵبژێرە. پاشەکەوتکردن لە ئێستاوە وەشانێکی نوێ دروست دەکات؛ فرۆشتنە پێشووەکان تێچووی خۆیان دەهێڵنەوە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Zutaten aus deiner Preisliste. Speichern legt ab jetzt eine neue Version an; frühere Verkäufe behalten ihre Kosten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les ingrédients dans votre liste de prix. Enregistrer crée une nouvelle version dès maintenant ; les ventes passées gardent leur coût."
          }
        }
      }
    },
