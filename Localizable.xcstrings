        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas encore de prix au kg. Il est gardé pour la prochaine fois."
          }
        }
      }
    },
    "%@ has no selling price yet. It's kept for next time." : {
      "extractionState" : "manual",
