          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ئەم بڕە و پاکەتەکە هەمان شت ناپێون (کێش، قەبارە یان ژمارە)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
