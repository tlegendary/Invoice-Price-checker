    "Give items a selling price in your price list (open an item › Sell at the till), import your products (Till settings › Import products), or search above and set a price here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعطِ الأصناف سعر بيع في قائمة أسعارك (افتح صنفًا › البيع على الكاشير)، أو استورد منتجاتك (إعدادات الكاشير › استيراد المنتجات)، أو ابحث أعلاه وحدّد سعرًا هنا."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نرخی فرۆشتن بدە بە کاڵاکان لە لیستی نرخەکەتدا (کاڵایەک بکەرەوە › فرۆشتن لە کاشێر)، بەرهەمەکانت هاوردە بکە (ڕێکخستنەکانی کاشێر › هاوردەکردنی بەرهەم)، یان لە سەرەوە بگەڕێ و نرخێک لێرە دابنێ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Artikeln in deiner Preisliste einen Verkaufspreis (Artikel öffnen › An der Kasse verkaufen), importiere deine Produkte (Kasseneinstellungen › Produkte importieren) oder suche oben und lege hier einen Preis fest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez un prix de vente aux articles de votre liste (ouvrez un article › Vendre en caisse), importez vos produits (Réglages de la caisse › Importer des produits), ou cherchez ci-dessus et fixez un prix ici."
          }
        }
      }
    },
    "Give items a selling price in your price list (open an item › Sell at the till), or search for one above and set its price here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعطِ الأصناف سعر بيع في قائمة أسعارك (افتح صنفًا › البيع على الكاشير)، أو ابحث عن صنف أعلاه وحدّد سعره هنا."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نرخی فرۆشتن بدە بە کاڵاکان لە لیستی نرخەکەتدا (کاڵایەک بکەرەوە › فرۆشتن لە کاشێر)، یان لە سەرەوە بەدوای یەکێکدا بگەڕێ و نرخەکەی لێرە دابنێ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Artikeln in deiner Preisliste einen Verkaufspreis (Artikel öffnen › An der Kasse verkaufen) oder suche oben einen und lege hier den Preis fest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez un prix de vente aux articles de votre liste (ouvrez un article › Vendre en caisse), ou cherchez-en un ci-dessus et fixez son prix ici."
          }
        }
      }
    },
