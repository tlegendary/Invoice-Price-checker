    "Couldn't confirm this price against the line total – check the price and quantity." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تأكيد هذا السعر مع مجموع البند – تحقّق من السعر والكمية."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نەتوانرا ئەم نرخە لەگەڵ کۆی دێڕەکە پشتڕاست بکرێتەوە – نرخ و بڕەکە بپشکنە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Preis passt nicht zur Positionssumme – prüfe Preis und Menge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de confirmer ce prix avec le total de la ligne – vérifiez le prix et la quantité."
          }
        }
      }
    },
    "Couldn't find any item lines. Retake the photo flat and close, in good light, or add the lines by hand." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم العثور على أي بنود. أعد التصوير والفاتورة مسطّحة وقريبة وفي إضاءة جيدة، أو أضف البنود يدويًا."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هیچ دێڕێکی کاڵا نەدۆزرایەوە. وێنەکە بە ڕێکی و نزیکەوە و لە ڕووناکییەکی باشدا دووبارە بگرەوە، یان دێڕەکان بە دەست زیاد بکە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Artikelpositionen gefunden. Fotografiere die Rechnung flach und nah bei gutem Licht oder füge die Positionen von Hand hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune ligne d’article trouvée. Reprenez la photo bien à plat et de près, avec une bonne lumière, ou ajoutez les lignes à la main."
          }
        }
      }
    },
    "Couldn't read the credit note's total. Type it in." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة إجمالي الإشعار الدائن. اكتبه."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کۆی گەڕاندنەوەکە نەخوێندرایەوە. بینووسە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Betrag der Gutschrift konnte nicht gelesen werden. Gib ihn ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le total de l’avoir n’a pas pu être lu. Saisissez-le."
          }
        }
