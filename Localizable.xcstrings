    "Your items already have the usual names, or another name would be too easy to mix up with another item." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصنافك لديها الأسماء المعتادة بالفعل، أو أن أي اسم آخر قد يختلط بصنف آخر."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کاڵاکانت پێشتر ناوە باوەکانیان هەیە، یان ناوێکی تر زۆر ئاسان لەگەڵ کاڵایەکی تر تێکەڵ دەبێت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Artikel haben schon die üblichen Namen, oder ein anderer Name wäre leicht mit einem anderen Artikel zu verwechseln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos articles ont déjà les noms habituels, ou un autre nom se confondrait trop facilement avec un autre article."
          }
        }
      }
    },
    "Your last changes didn't save. Tap for details." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُحفظ تغييراتك الأخيرة. اضغط للتفاصيل."
