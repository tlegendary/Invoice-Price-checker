    "The free version gives you one scan for each ad you watch to the end." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمنحك النسخة المجانية مسحًا واحدًا مقابل كل إعلان تشاهده حتى النهاية."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وەشانی بەخۆڕایی بۆ هەر ڕیکلامێک کە تا کۆتایی سەیری دەکەیت سکانێکت پێدەدات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Gratisversion bekommst du für jede bis zum Ende angesehene Werbung einen Scan."
