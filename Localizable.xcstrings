    "How much are they paying? Cash goes in this till's drawer." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كم يدفع؟ النقد يذهب إلى درج هذا الكاشير."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چەند دەدات؟ پارەی نەختینە دەچێتە چەکمەجەی ئەم کاشێرە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
