    "%@. Automatic follows your iPhone's light or dark setting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. «تلقائي» يتبع إعداد الوضع الفاتح أو الداكن في جهاز iPhone."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. «خۆکار» ڕێکخستنی ڕووناک یان تاریکی iPhone ـەکەت دەگرێتە بەر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. „Automatisch“ folgt der Hell-/Dunkel-Einstellung deines iPhones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. « Automatique » suit le réglage clair ou sombre de votre iPhone."
          }
        }
