    },
    "The owner's prices and reports are removed from this phone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُزال أسعار المالك وتقاريره من هذا الهاتف."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نرخ و ڕاپۆرتەکانی خاوەنەکە لەم مۆبایلە لادەبرێن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
