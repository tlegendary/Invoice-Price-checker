        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرقام اليوم لكل المحلات. اختر محلاً في الأعلى لرؤيته وحده."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ژمارەکانی ئەمڕۆ بۆ هەموو دووکانەکانن. لە سەرەوە دووکانێک هەڵبژێرە بۆ بینینی تەنها ئەو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die heutigen Zahlen gelten für alle Läden. Wähle oben einen Laden, um nur ihn zu sehen."
