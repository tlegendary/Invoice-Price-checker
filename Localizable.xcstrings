    "Batch %@ of %@ expired on %@. Take it off the shelf. Check the date on the one in your hand." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية الدفعة %1$@ من %2$@ في %3$@. أزلها من الرف. تحقق من التاريخ على القطعة التي في يدك."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وەجبەی %1$@ی %2$@ لە %3$@ بەسەرچووە. لە ڕەفەکە لای ببە. بەرواری ئەوەی لە دەستتە بپشکنە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charge %1$@ von %2$@ ist am %3$@ abgelaufen. Nimm sie aus dem Regal. Prüfe das Datum auf dem Stück in deiner Hand."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lot %1$@ de %2$@ a expiré le %3$@. Retirez-le du rayon. Vérifiez la date sur celui que vous tenez."
          }
        }
      }
    },
