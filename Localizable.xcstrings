          }
        }
      }
    },
    "Before VAT, by each invoice's date. Missing or returned items aren't counted. Give items a category in your price list to sort them here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل الضريبة، حسب تاريخ كل فاتورة. لا تُحتسب الأصناف الناقصة أو المرتجعة. أعطِ الأصناف فئة في قائمة أسعارك لترتيبها هنا."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پێش باج، بەپێی بەرواری هەر پسوولەیەک. کاڵا نەگەیشتوو یان گەڕاوەکان ناژمێردرێن. بۆ ڕیزکردنیان لێرە، لە لیستی نرخەکەتدا پۆلێک بدە بە کاڵاکان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor MwSt., nach dem Datum jeder Rechnung. Fehlende oder zurückgegebene Artikel zählen nicht. Gib Artikeln in deiner Preisliste eine Kategorie, um sie hier zu sortieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hors TVA, selon la date de chaque facture. Les articles manquants ou retournés ne comptent pas. Donnez une catégorie aux articles de votre liste de prix pour les classer ici."
          }
        }
      }
    },
