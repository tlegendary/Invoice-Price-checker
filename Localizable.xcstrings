        }
      }
    },
    "Before VAT and VAT are worked out in proportion from their invoices, because part of what you owe isn't whole invoices (a starting balance or part-payments)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحسب المبلغ قبل الضريبة والضريبة بالتناسب من فواتيرهم، لأن جزءاً مما تدين به ليس فواتير كاملة (رصيد افتتاحي أو دفعات جزئية)."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پێش باج و باج بە ڕێژە لە پسوولەکانیانەوە دەژمێردرێن، چونکە بەشێک لەوەی قەرزارتی پسوولەی تەواو نییە (باڵانسی سەرەتا یان پارەدانی بەشێک)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne MwSt. und MwSt. sind anteilig aus ihren Rechnungen berechnet, weil ein Teil der Schuld keine ganzen Rechnungen sind (Anfangssaldo oder Teilzahlungen)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le hors TVA et la TVA sont calculés au prorata de leurs factures, car une partie de ce que vous devez n'est pas des factures entières (solde de départ ou paiements partiels)."
          }
        }
      }
    },
    "Before VAT {1} + VAT {2}" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل الضريبة {1} + الضريبة {2}"
          }
        },
        "ckb" : {
