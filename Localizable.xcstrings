    "Set a monthly limit for a supplier or a category. Home warns you when 80% is used." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّد سقفًا شهريًا لمورد أو فئة. تنبهك الصفحة الرئيسية عند استخدام 80%."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنووری مانگانە بۆ دابینکەرێک یان پۆلێک دابنێ. سەرەکی ئاگادارت دەکاتەوە کاتێک ٨٠٪ بەکارهات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege ein Monatslimit für einen Lieferanten oder eine Kategorie fest. Die Startseite warnt dich bei 80 %."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixez une limite mensuelle pour un fournisseur ou une catégorie. L'accueil vous avertit à 80 %."
          }
        }
      }
    },
    "Set a price" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّد سعرًا"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نرخێک دابنێ"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preis festlegen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixer un prix"
          }
        }
      }
    },
    "Set the date a supplier's prices end on their page in Suppliers." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّد تاريخ انتهاء أسعار المورد من صفحته في الموردين."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بەرواری کۆتایی نرخەکانی دابینکەرێک لە پەڕەکەیدا لە دابینکەران دابنێ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege das Enddatum der Preise eines Lieferanten auf seiner Seite unter Lieferanten fest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez la date de fin des prix d'un fournisseur sur sa page dans Fournisseurs."
          }
        }
      }
    },
    "Set when their agreed prices end: you get a reminder two weeks before, to renegotiate with their supplier report." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّد متى تنتهي أسعارهم المتفق عليها: يصلك تذكير قبل أسبوعين لإعادة التفاوض بتقرير المورد."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دیاری بکە نرخە ڕێککەوتووەکانیان کەی کۆتایی دێن: دوو هەفتە پێشتر بیرخستنەوەیەکت پێدەگات، بۆ دووبارە دانوستان بە ڕاپۆرتی دابینکەر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, wann ihre vereinbarten Preise enden: Du bekommst zwei Wochen vorher eine Erinnerung, um mit dem Lieferantenbericht neu zu verhandeln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez quand leurs prix convenus prennent fin : un rappel arrive deux semaines avant, pour renégocier avec le rapport fournisseur."
          }
        }
      }
    },
