    "Photos or PDFs. Read on this phone, works offline, and every invoice is read twice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صور أو ملفات PDF. تُقرأ على هذا الهاتف وتعمل دون إنترنت، وكل فاتورة تُقرأ مرتين."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وێنە یان PDF. لەسەر ئەم مۆبایلە دەخوێندرێتەوە، بێ ئینتەرنێت کار دەکات، و هەموو پسوولەیەک دوو جار دەخوێندرێتەوە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos oder PDFs. Auf diesem iPhone gelesen, funktioniert offline, und jede Rechnung wird zweimal gelesen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos ou PDF. Lus sur ce téléphone, hors ligne, et chaque facture est lue deux fois."
          }
        }
      }
    },
