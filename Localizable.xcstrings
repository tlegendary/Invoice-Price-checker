        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce dossier ne peut pas être utilisé. Choisissez-en un autre."
          }
        }
      }
    },
    "That invoice couldn't be read, so your scan was given back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة هذه الفاتورة، لذلك أُعيد إليك المسح."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ئەو پسوولەیە نەخوێندرایەوە، بۆیە سکانەکەت بۆ گەڕێنرایەوە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Rechnung konnte nicht gelesen werden, daher hast du deinen Scan zurückbekommen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette facture n’a pas pu être lue, votre scan vous a donc été rendu."
          }
        }
      }
    },
    "That isn't a ChargeCheck backup file." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا ليس ملف نسخة احتياطية من ChargeCheck."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ئەمە فایلی باکئەپی ChargeCheck نییە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist keine ChargeCheck-Backup-Datei."
