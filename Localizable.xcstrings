        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هەموو پسوولەیەک کە دەیپشکنیت لێرە هەڵدەگیرێت، لەگەڵ ئەو بڕە زیادەیەی هەر دابینکەرێک وەریگرتووە."
