    },
    "This PDF is a scanned picture, so there's no text to read. Ask the supplier for the PDF they made on a computer, or a spreadsheet." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف PDF هذا صورة ممسوحة ضوئيًا، فلا يوجد نص لقراءته. اطلب من المورد ملف PDF المُعد على الكمبيوتر، أو جدول بيانات."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ئەم PDFـە وێنەیەکی سکانکراوە، بۆیە دەقی تێدا نییە بۆ خوێندنەوە. داوا لە دابینکەر بکە ئەو PDFـەی بە کۆمپیوتەر دروستی کردووە، یان خشتەیەک بنێرێت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese PDF ist ein eingescanntes Bild, es gibt keinen Text zum Lesen. Bitte den Lieferanten um die am Computer erstellte PDF oder eine Tabelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce PDF est une image scannée, il n'y a donc pas de texte à lire. Demandez au fournisseur le PDF fait sur ordinateur, ou un tableur."
          }
        }
      }
    },
    "This amount and the pack don't measure the same thing (weight, volume or count)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
