      }
    },
    "Only %@ more can go on %@'s account: take the rest another way." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن وضع %@ فقط على حساب %@: خذ الباقي بطريقة أخرى."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تەنها %@ی زیاتر دەتوانێت بچێتە سەر حیسابی %@: باقییەکەی بە ڕێگەیەکی تر وەربگرە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur noch %@ passen auf das Konto von %@: den Rest anders kassieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement %@ de plus sur le compte de %@ : encaissez le reste autrement."
          }
        }
      }
    },
    "Only a manager or the owner can change the till settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط المدير أو المالك يمكنه تغيير إعدادات الكاشير."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تەنها بەڕێوەبەر یان خاوەن دەتوانێت ڕێکخستنەکانی کاشێر بگۆڕێت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ein Filialleiter oder der Inhaber kann die Kasseneinstellungen ändern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul un responsable ou le propriétaire peut modifier les réglages de la caisse."
          }
        }
      }
    },
    "Only a manager or the owner can change this." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط المدير أو المالك يمكنه تغيير هذا."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تەنها بەڕێوەبەر یان خاوەن دەتوانێت ئەمە بگۆڕێت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ein Filialleiter oder der Inhaber kann das ändern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul un responsable ou le propriétaire peut modifier ceci."
          }
        }
      }
    },
    "Only credits received count as money won back. Written off: the supplier wouldn't credit it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُحتسب مالًا مستردًا إلا الرصيد المستلَم. المشطوب: لم يقبل المورد منحه."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تەنها کرێدیتی وەرگیراو وەک پارەی گەڕاوە دەژمێردرێت. سڕاوەتەوە: دابینکەر ئامادە نەبوو بیدات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur erhaltene Gutschriften zählen als zurückgeholtes Geld. Abgeschrieben: Der Lieferant hat sie nicht gewährt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les avoirs reçus comptent comme argent récupéré. Passé en perte : le fournisseur a refusé."
          }
        }
      }
    },
    "Only for credits that weren't already taken off one of their invoices in ChargeCheck." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط للإشعارات الدائنة التي لم تُخصم من إحدى فواتيرهم في ChargeCheck."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تەنها بۆ ئەو گەڕاندنەوانەی پێشتر لە یەکێک لە پسوولەکانیان لە ChargeCheck نەبڕدراون."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für Gutschriften, die nicht schon bei einer Rechnung in ChargeCheck abgezogen wurden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement pour les avoirs qui n’ont pas déjà été déduits d’une de leurs factures dans ChargeCheck."
          }
        }
      }
    },
    "Only found on the second read – make sure it's really on the invoice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وُجد في القراءة الثانية فقط – تأكّد أنه موجود فعلًا في الفاتورة."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تەنها لە خوێندنەوەی دووەمدا دۆزرایەوە – دڵنیا بەرەوە کە بەڕاستی لەسەر پسوولەکەیە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur beim zweiten Lesen gefunden – prüfe, ob sie wirklich auf der Rechnung steht."
          }
        },
