    "One to three letters or numbers, different on every till. It's on every receipt number from this till." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من حرف إلى ثلاثة أحرف أو أرقام، مختلفة لكل كاشير. تظهر في رقم كل إيصال من هذا الكاشير."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یەک تا سێ پیت یان ژمارە، لە هەر کاشێرێک جیاواز. لەسەر ژمارەی هەموو پسوولەکانی ئەم کاشێرە دەردەکەوێت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein bis drei Buchstaben oder Ziffern, an jeder Kasse anders. Sie steht in jeder Belegnummer dieser Kasse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une à trois lettres ou chiffres, différents sur chaque caisse. Ils figurent dans chaque numéro de ticket de cette caisse."
          }
        }
      }
    },
    "Only %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
