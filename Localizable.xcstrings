    "The cash drawer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درج النقود"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چەکمەجەی پارە"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kassenschublade"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tiroir-caisse"
          }
        }
      }
    },
    "The cash drawer plugs into the printer. It opens by itself when a sale is paid in cash. Opening it without a sale is logged in Records." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُوصل درج النقود بالطابعة. يُفتح تلقائياً عند الدفع نقداً. فتحه بدون بيع يُسجَّل في السجلات."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چەکمەجەی پارە بە چاپکەرەکەوە دەبەسترێت. کاتێک فرۆشێک بە نەختینە دەدرێت خۆی دەکرێتەوە. کردنەوەی بێ فرۆشتن لە تۆمارەکاندا تۆمار دەکرێت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kassenschublade wird an den Drucker angeschlossen. Sie öffnet sich bei Barzahlung von selbst. Öffnen ohne Verkauf wird in den Protokollen vermerkt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tiroir-caisse se branche sur l'imprimante. Il s'ouvre tout seul pour une vente en espèces. L'ouvrir sans vente est noté dans l'historique."
          }
        }
      }
    },
    "The copy of the original invoice in the Files app is kept." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستبقى نسخة الفاتورة الأصلية في تطبيق الملفات."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کۆپیی پسوولەی ڕەسەن لە ئەپی Files دەمێنێتەوە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie der Originalrechnung in der Dateien-App bleibt erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie de la facture d’origine dans l’app Fichiers est conservée."
