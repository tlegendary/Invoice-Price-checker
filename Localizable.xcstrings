    "Costs %@ · sells %@ · you keep %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التكلفة %@ · البيع %@ · يبقى لك %@"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تێچوو %@ · فرۆشتن %@ · بۆت دەمێنێتەوە %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostet %@ · verkauft für %@ · dir bleiben %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coûte %@ · vendu %@ · il vous reste %@"
          }
        }
      }
    },
    "Costs use your agreed prices (each shop's own price where it has one). Food cost is the ingredients as a share of the price without VAT." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحسب التكاليف من أسعارك المتفق عليها (سعر كل متجر الخاص إن وُجد). تكلفة الطعام هي نسبة المكوّنات من السعر دون ضريبة."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تێچووەکان نرخە ڕێککەوتووەکانت بەکاردەهێنن (نرخی تایبەتی هەر دوکانێک ئەگەر هەبێت). تێچووی خواردن بەشی پێکهاتەکانە لە نرخی بێ باج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kosten nutzen deine vereinbarten Preise (den eigenen Preis jeder Filiale, wo es einen gibt). Wareneinsatz ist der Anteil der Zutaten am Preis ohne MwSt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les coûts utilisent vos prix convenus (le prix propre de chaque magasin s'il en a un). Le coût matière est la part des ingrédients dans le prix hors TVA."
          }
        }
      }
    },
    "Couldn't confirm this price against the line total – check the price and quantity." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تأكيد هذا السعر مع مجموع البند – تحقّق من السعر والكمية."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نەتوانرا ئەم نرخە لەگەڵ کۆی دێڕەکە پشتڕاست بکرێتەوە – نرخ و بڕەکە بپشکنە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Preis passt nicht zur Positionssumme – prüfe Preis und Menge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de confirmer ce prix avec le total de la ligne – vérifiez le prix et la quantité."
          }
        }
      }
    },
    "Couldn't find any item lines. Retake the photo flat and close, in good light, or add the lines by hand." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم العثور على أي بنود. أعد التصوير والفاتورة مسطّحة وقريبة وفي إضاءة جيدة، أو أضف البنود يدويًا."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هیچ دێڕێکی کاڵا نەدۆزرایەوە. وێنەکە بە ڕێکی و نزیکەوە و لە ڕووناکییەکی باشدا دووبارە بگرەوە، یان دێڕەکان بە دەست زیاد بکە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Artikelpositionen gefunden. Fotografiere die Rechnung flach und nah bei gutem Licht oder füge die Positionen von Hand hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune ligne d’article trouvée. Reprenez la photo bien à plat et de près, avec une bonne lumière, ou ajoutez les lignes à la main."
          }
        }
      }
    },
    "Couldn't read the credit note's total. Type it in." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة إجمالي الإشعار الدائن. اكتبه."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کۆی گەڕاندنەوەکە نەخوێندرایەوە. بینووسە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Betrag der Gutschrift konnte nicht gelesen werden. Gib ihn ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le total de l’avoir n’a pas pu être lu. Saisissez-le."
          }
        }
      }
    },
    "Couldn't read the invoice total. Type it in." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة إجمالي الفاتورة. اكتبه."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کۆی پسوولەکە نەخوێندرایەوە. بینووسە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rechnungssumme konnte nicht gelesen werden. Gib sie ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le total de la facture n’a pas pu être lu. Saisissez-le."
          }
        }
      }
    },
    "Count many items in one go, see what's missing or extra at cost, then save the whole count." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصِ أصنافاً كثيرة دفعة واحدة، وانظر الناقص أو الزائد بسعر التكلفة، ثم احفظ الجرد كاملاً."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زۆر کاڵا بەیەکجار بژمێرە، ئەوەی کەمە یان زیادە بە نرخی تێچوو ببینە، پاشان هەموو ژماردنەکە پاشەکەوت بکە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viele Artikel auf einmal zählen, Fehlmengen oder Überschuss zum Einkaufspreis sehen und dann alles speichern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptez de nombreux articles d'un coup, voyez les manques ou surplus au coût, puis enregistrez tout le comptage."
          }
        }
      }
    },
    "Count on the shelf" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العدد على الرف"
