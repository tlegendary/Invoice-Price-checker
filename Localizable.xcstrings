        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چاپکەرەکەی %@ وەڵامی نەدایەوە. دڵنیابە کە هەڵکراوە و لەسەر هەمان Wi-Fiیە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Drucker unter %@ hat nicht geantwortet. Prüfe, ob er an und im selben WLAN ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'imprimante à %@ n'a pas répondu. Vérifiez qu'elle est allumée et sur le même Wi-Fi."
          }
        }
      }
    },
    "The printer works." : {
