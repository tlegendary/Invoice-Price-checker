    "That folder couldn't be used. Please choose another one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن استخدام هذا المجلد. يرجى اختيار مجلد آخر."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ناتوانرێت ئەو فۆڵدەرە بەکاربهێنرێت. تکایە یەکێکی تر هەڵبژێرە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
