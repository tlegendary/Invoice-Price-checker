    "The Bluetooth printer didn't connect. Turn it on and keep it close." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تتصل طابعة البلوتوث. شغّلها وأبقها قريبة."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چاپکەری بلووتووس پەیوەست نەبوو. هەڵیبکە و نزیکی بهێڵەرەوە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bluetooth-Drucker hat sich nicht verbunden. Schalte ihn ein und halte ihn in der Nähe."
