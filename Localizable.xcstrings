    "%@. Automatic follows your iPhone's light or dark setting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. «تلقائي» يتبع إعداد الوضع الفاتح أو الداكن في جهاز iPhone."
