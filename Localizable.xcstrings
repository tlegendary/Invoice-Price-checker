    "Credit periods for each supplier, with overdue invoices and the cash you need this week." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدة سداد لكل مورد، مع الفواتير المتأخرة والنقد الذي تحتاجه هذا الأسبوع."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماوەی پارەدان بۆ هەر دابینکەرێک، لەگەڵ پسوولە دواکەوتووەکان و ئەو پارەیەی ئەم هەفتە پێویستتە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlungsziele für jeden Lieferanten, mit überfälligen Rechnungen und dem Geld, das du diese Woche brauchst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délais de paiement par fournisseur, avec les factures en retard et l'argent nécessaire cette semaine."
          }
        }
      }
    },
    "Credit received" : {
      "localizations" : {
        "ar" : {
