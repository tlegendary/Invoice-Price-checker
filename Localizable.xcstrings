            "value" : "أضف سعرًا اتفقت عليه مع %@ إذا كان مختلفًا عن سعرك العادي. ستُفحص فواتيره على أساسه."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نرخێک زیاد بکە کە لەگەڵ %@ ڕێککەوتوویت ئەگەر جیاوازە لە نرخی ئاساییت. پسوولەکانی بەو نرخە دەپشکنرێن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen mit %@ vereinbarten Preis hinzu, wenn er von deinem Standardpreis abweicht. Ihre Rechnungen werden dann damit geprüft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un prix convenu avec %@ quand il diffère de votre prix standard. Ses factures seront vérifiées avec ce prix."
