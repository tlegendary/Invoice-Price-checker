    "Every invoice double-checked before you see the result" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل فاتورة يتم فحصها مرتين قبل أن ترى النتيجة"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هەموو پسوولەیەک دوو جار دەپشکنرێت پێش ئەوەی ئەنجامەکە ببینیت"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Rechnung wird doppelt geprüft, bevor du das Ergebnis siehst"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque facture est vérifiée deux fois avant que vous voyiez le résultat"
          }
        }
      }
    },
    "Every invoice is checked" : {

    },
    "Every invoice you check is kept here, with what each supplier overcharged." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل فاتورة تفحصها تُحفظ هنا، مع المبلغ الزائد الذي فرضه كل مورّد."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هەموو پسوولەیەک کە دەیپشکنیت لێرە هەڵدەگیرێت، لەگەڵ ئەو بڕە زیادەیەی هەر دابینکەرێک وەریگرتووە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede geprüfte Rechnung wird hier gespeichert, mit dem, was jeder Lieferant zu viel berechnet hat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque facture vérifiée est conservée ici, avec ce que chaque fournisseur a surfacturé."
          }
        }
      }
    },
    "Every line double-checked." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم فحص كل بند مرتين."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هەموو دێڕێک دوو جار پشکنرا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Position doppelt geprüft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque ligne vérifiée deux fois."
          }
        }
      }
    },
    "Every way suppliers write this item, one per line. The app recognises the item by any of them. When you pick the right item for a line it didn't recognise, that name is added here for you. Swipe left to remove one." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل طريقة يكتب بها المورّدون هذا الصنف، واحدة في كل سطر. يتعرّف التطبيق على الصنف بأيٍّ منها. عندما تختار الصنف الصحيح لسطر لم يتعرّف عليه، يُضاف ذلك الاسم هنا تلقائيًا. اسحب لليسار للإزالة."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هەموو ئەو شێوانەی دابینکەران ئەم کاڵایە دەنووسن، هەر یەکە لە دێڕێکدا. ئەپەکە بە هەر یەکێکیان کاڵاکە دەناسێتەوە. کاتێک کاڵای ڕاست بۆ دێڕێکی نەناسراو هەڵدەبژێریت، ئەو ناوە خۆکارانە لێرە زیاد دەکرێت. بۆ لابردن بەرەو چەپ ڕابکێشە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Schreibweise der Lieferanten für diesen Artikel, eine pro Zeile. Die App erkennt den Artikel an jeder davon. Wenn du für eine unbekannte Zeile den richtigen Artikel wählst, wird dieser Name hier automatisch ergänzt. Nach links wischen zum Entfernen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque façon dont les fournisseurs écrivent cet article, une par ligne. L’app reconnaît l’article avec n’importe laquelle. Quand vous choisissez le bon article pour une ligne non reconnue, ce nom est ajouté ici automatiquement. Balayez vers la gauche pour en retirer un."
          }
        }
      }
    },
    "Everything arrived" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصل كل شيء"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
