        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'imprimante Bluetooth ne s'est pas connectée. Allumez-la et gardez-la à proximité."
          }
        }
      }
    },
    "The Bluetooth printer wasn't found. Turn it on, or choose it again in Till settings › Receipt printer." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم العثور على طابعة البلوتوث. شغّلها، أو اخترها مجدداً في إعدادات الكاشير › طابعة الإيصالات."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چاپکەری بلووتووس نەدۆزرایەوە. هەڵیبکە، یان دووبارە لە ڕێکخستنەکانی کاشێر › چاپکەری پسوولە هەڵیبژێرە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bluetooth-Drucker wurde nicht gefunden. Schalte ihn ein oder wähle ihn neu unter Kasseneinstellungen › Bondrucker."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'imprimante Bluetooth est introuvable. Allumez-la ou choisissez-la à nouveau dans Réglages de la caisse › Imprimante à tickets."
          }
        }
      }
    },
    "The ad was closed before the end, so no scan was added." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
