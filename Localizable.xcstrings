    "Profit is the price without VAT, less what the goods cost you (from your agreed prices when sold)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الربح هو السعر دون ضريبة ناقص تكلفة البضاعة عليك (من أسعارك المتفق عليها وقت البيع)."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قازانج نرخی بێ باجە، کەمکراوە لە تێچووی کاڵاکان (لە نرخە ڕێککەوتووەکانت لە کاتی فرۆشتندا)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewinn ist der Preis ohne MwSt. abzüglich der Warenkosten (aus deinen vereinbarten Preisen beim Verkauf)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bénéfice est le prix hors TVA moins le coût des marchandises (selon vos prix convenus au moment de la vente)."
          }
        }
      }
    },
    "Profit is the price without VAT, less what the goods cost you (from your agreed prices when sold). %lld lines had no cost, so they're left out of it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الربح هو السعر دون ضريبة ناقص تكلفة البضاعة عليك (من أسعارك المتفق عليها وقت البيع). %lld سطرًا بلا تكلفة، فاستُبعدت منه."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قازانج نرخی بێ باجە، کەمکراوە لە تێچووی کاڵاکان (لە نرخە ڕێککەوتووەکانت لە کاتی فرۆشتندا). %lld دێڕ تێچوویان نەبوو، بۆیە دەرهێنران."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewinn ist der Preis ohne MwSt. abzüglich der Warenkosten (aus deinen vereinbarten Preisen beim Verkauf). %lld Zeilen hatten keine Kosten und sind nicht enthalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bénéfice est le prix hors TVA moins le coût des marchandises (selon vos prix convenus au moment de la vente). %lld lignes sans coût sont exclues."
          }
        }
      }
    },
