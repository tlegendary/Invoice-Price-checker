    },
    "Nobody is a manager or the owner yet, so cashiers can do everything. Tap a name to change their role." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا أحد مدير أو مالك بعد، لذا يمكن للكاشيرين فعل كل شيء. اضغط على اسم لتغيير دوره."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هێشتا کەس بەڕێوەبەر یان خاوەن نییە، بۆیە کاشێرەکان دەتوانن هەموو شتێک بکەن. لەسەر ناوێک دابگرە بۆ گۆڕینی ڕۆڵەکەی."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch ist niemand Filialleiter oder Inhaber, also dürfen Kassierer alles. Tippe auf einen Namen, um die Rolle zu ändern."
          }
        },
        "fr" : {
          "stringUnit" : {
