    "Asks for Face ID, Touch ID or your passcode each time ChargeCheck opens, so staff or family using this phone can't see your prices and payments." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب بصمة الوجه أو بصمة الإصبع أو رمز الدخول في كل مرة يُفتح فيها ChargeCheck، حتى لا يرى الموظفون أو العائلة أسعارك ومدفوعاتك."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هەر جارێک ChargeCheck دەکرێتەوە داوای Face ID، Touch ID یان وشەی نهێنی دەکات، بۆ ئەوەی کارمەند یان خێزان نرخ و پارەدانەکانت نەبینن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt bei jedem Öffnen von ChargeCheck nach Face ID, Touch ID oder deinem Code, damit Mitarbeiter oder Familie deine Preise und Zahlungen nicht sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande Face ID, Touch ID ou votre code à chaque ouverture de ChargeCheck, pour que le personnel ou la famille ne voie pas vos prix et paiements."
          }
        }
      }
    },
