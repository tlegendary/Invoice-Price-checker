    "This looks like a delivery note, not an invoice. Check it before saving." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو هذا مذكرة تسليم وليس فاتورة. تحقق منه قبل الحفظ."
