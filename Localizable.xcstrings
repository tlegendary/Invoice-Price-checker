    "Deleted invoices, payments and prices can be brought back for 30 days." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن استعادة الفواتير والدفعات والأسعار المحذوفة خلال 30 يومًا."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پسوولە و پارەدان و نرخە سڕاوەکان تا 30 ڕۆژ دەگەڕێنرێنەوە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Rechnungen, Zahlungen und Preise lassen sich 30 Tage lang zurückholen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les factures, paiements et prix supprimés peuvent être récupérés pendant 30 jours."
          }
        }
      }
    },
    "Delivered" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم التوصيل"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گەیەندرا"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geliefert"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livré"
          }
        }
      }
    },
    "Delivered comes from ticking off the delivery on the invoice. Billed but not delivered: ask for a credit from the invoice." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المُسلّم يأتي من تأشير التسليم على الفاتورة. مُفوتر ولم يُسلّم: اطلب رصيدًا دائنًا من صفحة الفاتورة."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گەیەنراو لە نیشانەکردنی گەیاندنەکە لەسەر پسوولەکەوە دێت. پارەی لێوەرگیراوە بەڵام نەگەیشتووە: لە پسوولەکەوە داوای کرێدیت بکە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geliefert stammt aus dem Abhaken der Lieferung auf der Rechnung. Berechnet, aber nicht geliefert: Fordere über die Rechnung eine Gutschrift an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livré vient du pointage de la livraison sur la facture. Facturé mais non livré : demandez un avoir depuis la facture."
          }
        }
      }
    },
    "Delivered in full" : {
      "localizations" : {
