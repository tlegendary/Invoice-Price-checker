    "Couldn't confirm this price against the line total – check the price and quantity." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تأكيد هذا السعر مع مجموع البند – تحقّق من السعر والكمية."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نەتوانرا ئەم نرخە لەگەڵ کۆی دێڕەکە پشتڕاست بکرێتەوە – نرخ و بڕەکە بپشکنە."
          }
        },
