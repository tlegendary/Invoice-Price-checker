    "Invoice totals before VAT, less overcharges and missing or returned items. Choose “Before VAT” for a shop that isn’t VAT registered." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إجمالي الفواتير قبل الضريبة، مطروحًا منه الزيادات في الأسعار والبنود المفقودة أو المرتجعة. اختر «قبل الضريبة» للمتجر غير المسجّل في الضريبة."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کۆی پسوولەکان پێش VAT، کەمکراوە لە نرخی زیادە و کاڵای ون یان گەڕێنراوە. «پێش VAT» هەڵبژێرە بۆ دوکانێک کە بۆ VAT تۆمار نەکراوە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechnungssummen ohne MwSt., abzüglich Überberechnungen und fehlender oder zurückgegebener Artikel. Wähle „Ohne MwSt.“ für einen Laden ohne MwSt.-Registrierung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totaux des factures hors TVA, moins les surfacturations et les articles manquants ou retournés. Choisissez « Hors TVA » pour un magasin non assujetti à la TVA."
          }
        }
      }
    },
    "Invoice totals with VAT, less overcharges and missing or returned items." : {
      "localizations" : {
