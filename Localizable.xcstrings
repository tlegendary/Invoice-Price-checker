    "7-day free trial, then %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "٧ أيام مجانًا، ثم %@"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "٧ ڕۆژ بەخۆڕایی، دواتر %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 Tage gratis, dann %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 jours gratuits, puis %@"
          }
        }
      }
    },
    "7-day free trial, then %@ per month. Payment is charged to your Apple ID when you confirm (after the free trial ends)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "٧ أيام مجانًا، ثم %@ شهريًا. يُخصم المبلغ من حساب Apple الخاص بك عند التأكيد (بعد انتهاء الفترة المجانية)."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "٧ ڕۆژ بەخۆڕایی، دواتر %@ مانگانە. پارەکە لە کاتی پشتڕاستکردنەوەدا لە ئەکاونتی Apple ـەکەت دەبڕدرێت (دوای کۆتایی ماوەی بەخۆڕایی)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 Tage gratis, dann %@ pro Monat. Die Zahlung wird bei Bestätigung über deine Apple-ID abgerechnet (nach Ende der Testphase)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 jours gratuits, puis %@ par mois. Le paiement est débité sur votre identifiant Apple lors de la confirmation (après la fin de l’essai gratuit)."
          }
        }
      }
    },
    "7-day free trial, then %@ per year. Payment is charged to your Apple ID when you confirm (after the free trial ends)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "٧ أيام مجانًا، ثم %@ سنويًا. يُخصم المبلغ من حساب Apple الخاص بك عند التأكيد (بعد انتهاء الفترة المجانية)."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "٧ ڕۆژ بەخۆڕایی، دواتر %@ ساڵانە. پارەکە لە کاتی پشتڕاستکردنەوەدا لە ئەکاونتی Apple ـەکەت دەبڕدرێت (دوای کۆتایی ماوەی بەخۆڕایی)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 Tage gratis, dann %@ pro Jahr. Die Zahlung wird bei Bestätigung über deine Apple-ID abgerechnet (nach Ende der Testphase)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 jours gratuits, puis %@ par an. Le paiement est débité sur votre identifiant Apple lors de la confirmation (après la fin de l’essai gratuit)."
          }
        }
      }
    },
    "A backup holds your prices, reports and settings. One is kept automatically in the Files app › On My iPhone › ChargeCheck, with a copy for each of the last 14 days." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتوي النسخة الاحتياطية على أسعارك وتقاريرك وإعداداتك. تُحفظ نسخة تلقائيًا في تطبيق الملفات › على جهاز iPhone › ChargeCheck، مع نسخة لكل يوم من آخر ١٤ يومًا."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "باکئەپ نرخ و ڕاپۆرت و ڕێکخستنەکانت تێدایە. یەکێک بە خۆکاری لە ئەپی Files › On My iPhone › ChargeCheck هەڵدەگیرێت، لەگەڵ کۆپییەک بۆ هەر یەک لە ١٤ ڕۆژی ڕابردوو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Backup enthält deine Preise, Berichte und Einstellungen. Eines wird automatisch in der Dateien-App › Auf meinem iPhone › ChargeCheck gespeichert, mit einer Kopie für jeden der letzten 14 Tage."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde contient vos prix, rapports et réglages. Une est conservée automatiquement dans l’app Fichiers › Sur mon iPhone › ChargeCheck, avec une copie pour chacun des 14 derniers jours."
          }
        }
      }
    },
    "A copy is already kept in the Files app › On My iPhone › ChargeCheck › Invoices. You can also save it somewhere else or send it on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجد نسخة محفوظة بالفعل في تطبيق الملفات › على جهاز iPhone › ChargeCheck › Invoices. يمكنك أيضًا حفظها في مكان آخر أو إرسالها."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کۆپییەک پێشتر لە ئەپی Files › On My iPhone › ChargeCheck › Invoices هەڵگیراوە. دەتوانیت لە شوێنێکی تریش هەڵیبگریت یان بینێریت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kopie liegt bereits in der Dateien-App › Auf meinem iPhone › ChargeCheck › Invoices. Du kannst sie auch woanders speichern oder weiterschicken."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une copie est déjà conservée dans l’app Fichiers › Sur mon iPhone › ChargeCheck › Invoices. Vous pouvez aussi l’enregistrer ailleurs ou l’envoyer."
          }
        }
      }
    },
    "A reminder at 9am on the day you pay your suppliers." : {
