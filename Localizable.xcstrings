    "Invoices from %@ are checked against these prices instead of the standard ones. Swipe left to remove one." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُفحص فواتير %@ بهذه الأسعار بدل الأسعار العادية. اسحب لليسار للإزالة."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پسوولەکانی %@ بەم نرخانە دەپشکنرێن نەک نرخە ئاساییەکان. بۆ لابردن بەرەو چەپ ڕابکێشە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechnungen von %@ werden mit diesen Preisen statt den Standardpreisen geprüft. Nach links wischen zum Entfernen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les factures de %@ sont vérifiées avec ces prix au lieu des prix standard. Balayez vers la gauche pour en retirer un."
          }
        }
      }
    },
    "Invoices from a trusted supplier aren't price-checked. Scanning one just reads the total and adds it to what you owe them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فواتير المورّد الموثوق لا تُفحص أسعارها. عند مسحها يُقرأ الإجمالي فقط ويُضاف إلى المستحق عليك له."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پسوولەکانی دابینکەری متمانەپێکراو نرخەکانیان ناپشکنرێت. سکانکردن تەنها کۆکە دەخوێنێتەوە و دەیخاتە سەر قەرزەکەت بۆی."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechnungen eines vertrauenswürdigen Lieferanten werden nicht auf Preise geprüft. Beim Scannen wird nur die Summe gelesen und zu dem addiert, was du ihm schuldest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les factures d’un fournisseur fiable ne sont pas vérifiées. Le scan lit seulement le total et l’ajoute à ce que vous lui devez."
          }
        }
      }
    },
