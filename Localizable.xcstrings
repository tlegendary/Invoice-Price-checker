    "Your subscription renews automatically unless cancelled at least 24 hours before the end of the current period. Manage or cancel any time in your App Store account settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجدد اشتراكك تلقائيًا ما لم يُلغَ قبل ٢٤ ساعة على الأقل من نهاية الفترة الحالية. يمكنك إدارته أو إلغاؤه في أي وقت من إعدادات حساب App Store."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بەشداریکردنەکەت بە خۆکاری نوێ دەبێتەوە مەگەر لانیکەم ٢٤ کاتژمێر پێش کۆتایی ماوەی ئێستا هەڵبوەشێنرێتەوە. هەر کاتێک لە ڕێکخستنەکانی ئەکاونتی App Store بەڕێوەی ببە یان هەڵیبوەشێنەوە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Abo verlängert sich automatisch, wenn es nicht mindestens 24 Stunden vor Ende des laufenden Zeitraums gekündigt wird. Verwalte oder kündige es jederzeit in den Einstellungen deines App Store-Accounts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre abonnement se renouvelle automatiquement sauf résiliation au moins 24 heures avant la fin de la période en cours. Gérez-le ou résiliez-le à tout moment dans les réglages de votre compte App Store."
          }
        }
      }
