    "%@ has no price a kg yet. It's kept for next time." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ليس له سعر للكيلو بعد. سيُحفظ للمرة القادمة."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ هێشتا نرخی کیلۆی نییە. بۆ جاری داهاتوو هەڵدەگیرێت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat noch keinen Preis pro kg. Er wird fürs nächste Mal gespeichert."
