    },
    "Written by Apple Intelligence from the figures below. The figures come from your own invoices." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كتبه Apple Intelligence من الأرقام أدناه. الأرقام من فواتيرك أنت."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence لە ژمارەکانی خوارەوە نووسیویەتی. ژمارەکان لە پسوولەکانی خۆتەوەن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
