    "Several tills share their sales through iCloud. Turn on iCloud backup (Settings › iCloud backup) on every till first." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتشارك الكاشيرات مبيعاتها عبر iCloud. فعّل نسخ iCloud الاحتياطي (الإعدادات › نسخ iCloud الاحتياطي) على كل كاشير أولاً."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کاشێرەکان لە ڕێگەی iCloudەوە فرۆشەکانیان هاوبەش دەکەن. سەرەتا لەسەر هەموو کاشێرێک پاشەکەوتی iCloud (ڕێکخستنەکان › پاشەکەوتی iCloud) هەڵبکە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrere Kassen teilen ihre Verkäufe über iCloud. Schalte zuerst auf jeder Kasse das iCloud-Backup ein (Einstellungen › iCloud-Backup)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs caisses partagent leurs ventes via iCloud. Activez d'abord la sauvegarde iCloud (Réglages › Sauvegarde iCloud) sur chaque caisse."
          }
        }
      }
    },
