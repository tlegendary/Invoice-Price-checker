    "Training mode: new staff use the real till, but sales, refunds and cash aren't saved and stock doesn't change." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع التدريب: يستخدم الموظفون الجدد الكاشير الحقيقي، لكن المبيعات والاسترداد والنقد لا تُحفظ ولا يتغير المخزون."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دۆخی ڕاهێنان: کارمەندی نوێ کاشێری ڕاستەقینە بەکاردەهێنن، بەڵام فرۆش، گەڕاندنەوە و پارە پاشەکەوت ناکرێن و کۆگا ناگۆڕێت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainingsmodus: Neue Mitarbeiter nutzen die echte Kasse, aber Verkäufe, Erstattungen und Bargeld werden nicht gespeichert und der Bestand ändert sich nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
