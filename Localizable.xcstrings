    "A proper credit request to send your supplier, with every overcharge and missing item." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلب إشعار دائن كامل لمورّدك، بكل مبلغ زائد وكل صنف ناقص."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "داواکارییەکی گەڕاندنەوەی تەواو بۆ دابینکەرەکەت، بە هەموو نرخی زیادە و کاڵای نەگەیشتوو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine richtige Gutschriftanforderung für deinen Lieferanten, mit jeder Überberechnung und jedem fehlenden Artikel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une vraie demande d'avoir pour votre fournisseur, avec chaque surfacturation et article manquant."
          }
        }
      }
    },
    "A reminder at 9am on the day you pay your suppliers." : {
      "extractionState" : "manual",
