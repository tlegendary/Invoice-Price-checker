        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پاشەکەوتی یەدەگەکە نەکرا، بۆیە هیچ نەگۆڕا. هەندێک شوێن بەتاڵ بکە و دووبارە هەوڵ بدەرەوە."
          }
        },
        "de" : {
          "stringUnit" : {
