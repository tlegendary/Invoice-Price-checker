    "Refunds, discounts, cash out and closing the day need a manager's or the owner's PIN unless cashiers are allowed. Swipe left to remove someone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاسترداد والخصومات وإخراج النقد وإغلاق اليوم تحتاج الرقم السري للمدير أو المالك ما لم يُسمح للكاشيرين. اسحب لليسار لإزالة شخص."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گەڕاندنەوەی پارە، داشکاندن، دەرهێنانی پارە و داخستنی ڕۆژ PINی بەڕێوەبەر یان خاوەنیان دەوێت، مەگەر ڕێگە بە کاشێرەکان درابێت. بۆ لابردنی کەسێک بەرەو چەپ ڕابکێشە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstattungen, Rabatte, Bargeld raus und Tagesabschluss brauchen die PIN eines Filialleiters oder des Inhabers, außer Kassierer dürfen es. Nach links wischen, um jemanden zu entfernen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remboursements, remises, sorties d'espèces et clôture demandent le code d'un responsable ou du propriétaire, sauf si les caissiers y sont autorisés. Balayez vers la gauche pour retirer quelqu'un."
          }
        }
      }
    },
    "Refunds, discounts, cash out and closing the day need a manager's or the owner's PIN unless cashiers are allowed. Swipe left to remove someone; touch and hold to reset their PIN." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاسترداد والخصومات وإخراج النقد وإغلاق اليوم تحتاج الرقم السري للمدير أو المالك ما لم يُسمح للكاشيرين. اسحب لليسار لإزالة شخص، واضغط مطولاً لإعادة تعيين رقمه السري."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گەڕاندنەوەی پارە، داشکاندن، دەرهێنانی پارە و داخستنی ڕۆژ PINی بەڕێوەبەر یان خاوەنیان دەوێت، مەگەر ڕێگە بە کاشێرەکان درابێت. بۆ لابردنی کەسێک بەرەو چەپ ڕابکێشە؛ بۆ نوێکردنەوەی PINەکەی پەنجە ڕابگرە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstattungen, Rabatte, Bargeld raus und Tagesabschluss brauchen die PIN eines Filialleiters oder des Inhabers, außer Kassierer dürfen es. Nach links wischen, um jemanden zu entfernen; gedrückt halten, um die PIN zurückzusetzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remboursements, remises, sorties d'espèces et clôture demandent le code d'un responsable ou du propriétaire, sauf si les caissiers y sont autorisés. Balayez vers la gauche pour retirer quelqu'un ; appuyez longuement pour réinitialiser son code."
          }
        }
      }
    },
    "Remove" : {
