    "Sell from your iPhone or iPad: stock that follows every sale, supplier orders when it runs low, profit per sale, cashiers and end-of-day reports." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بِع من الـ iPhone أو الـ iPad: مخزون يتبع كل بيع، وطلبيات للموردين عند النفاد، وربح كل بيع، وكاشيرون، وتقارير نهاية اليوم."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لە iPhone یان iPadـەوە بفرۆشە: کۆگایەک کە دوای هەر فرۆشێک دەکەوێت، داواکاری بۆ دابینکەران کاتێک کەم دەبێتەوە، قازانجی هەر فرۆشێک، کاشێرەکان و ڕاپۆرتی کۆتایی ڕۆژ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkaufe vom iPhone oder iPad: Bestand, der jedem Verkauf folgt, Lieferantenbestellungen bei Knappheit, Gewinn pro Verkauf, Kassierer und Tagesabschlüsse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendez depuis votre iPhone ou iPad : un stock qui suit chaque vente, des commandes fournisseurs quand il baisse, le bénéfice par vente, des caissiers et des rapports de fin de journée."
          }
        }
      }
    },
