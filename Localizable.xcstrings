        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوایین گۆڕانکارییەکانت پاشەکەوت نەکران. بۆ وردەکاری دابگرە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine letzten Änderungen wurden nicht gespeichert. Für Details tippen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos dernières modifications n'ont pas été enregistrées. Touchez pour en savoir plus."
          }
        }
      }
    },
    "Your last iCloud backup couldn't be opened again. It will be saved again next time you leave the app; if this stays, check iCloud has space." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر فتح آخر نسخة احتياطية في iCloud مرة أخرى. ستُحفظ من جديد عند خروجك من التطبيق؛ إن استمر ذلك، تأكد من وجود مساحة في iCloud."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کۆتا باکئەپی iCloud دووبارە نەکرایەوە. جارێکی تر پاشەکەوت دەکرێت کاتێک لە ئەپەکە دەردەچیت؛ ئەگەر بەردەوام بوو، دڵنیابە iCloud شوێنی هەیە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine letzte iCloud-Sicherung ließ sich nicht wieder öffnen. Sie wird beim nächsten Verlassen der App neu gespeichert; bleibt das so, prüfe, ob iCloud Platz hat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre dernière sauvegarde iCloud n'a pas pu être rouverte. Elle sera enregistrée à nouveau en quittant l'app ; si cela persiste, vérifiez l'espace iCloud."
          }
        }
      }
    },
