    "Off: the till goes straight to the next sale (it still shows when there's change to give). Every receipt is kept in Sales." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف: ينتقل الكاشير مباشرة إلى البيع التالي (ويظهر عند وجود باقٍ). كل إيصال يُحفظ في المبيعات."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوژاندنەوە: کاشێر ڕاستەوخۆ دەچێتە فرۆشی داهاتوو (هێشتا پیشان دەدرێت کاتێک باقی هەیە). هەموو پسوولەیەک لە فرۆشەکاندا دەهێڵرێتەوە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Die Kasse geht direkt zum nächsten Verkauf (er erscheint trotzdem, wenn es Rückgeld gibt). Jeder Beleg bleibt unter Verkäufe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : la caisse passe directement à la vente suivante (il s'affiche quand il y a de la monnaie à rendre). Chaque ticket est gardé dans Ventes."
          }
        }
      }
    },
