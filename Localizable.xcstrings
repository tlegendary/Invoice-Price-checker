    "To stop treating this supplier as trusted, go to Suppliers and turn off “Trusted supplier”." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لإيقاف اعتبار هذا المورّد موثوقًا، اذهب إلى المورّدون وأوقف «مورّد موثوق»."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بۆ ئەوەی ئیتر متمانەپێکراو نەبێت، بڕۆ بۆ دابینکەرەکان و «دابینکەری متمانەپێکراو» بکوژێنەوە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um diesem Lieferanten nicht mehr zu vertrauen, gehe zu Lieferanten und schalte „Vertrauenswürdiger Lieferant“ aus."
          }
        },
        "fr" : {
