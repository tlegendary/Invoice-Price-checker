    "Count the notes and coins, then close the day. The next day starts from now; the report is kept below." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عُدّ الأوراق والعملات، ثم أغلق اليوم. يبدأ اليوم التالي من الآن؛ ويُحفظ التقرير أدناه."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پارە کاغەز و دراوەکان بژمێرە، پاشان ڕۆژەکە دابخە. ڕۆژی داهاتوو لە ئێستاوە دەست پێدەکات؛ ڕاپۆرتەکە لە خوارەوە دەهێڵرێتەوە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zähle Scheine und Münzen und schließe dann den Tag. Der nächste Tag beginnt jetzt; der Bericht bleibt unten gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptez billets et pièces, puis clôturez la journée. La suivante commence maintenant ; le rapport est gardé ci-dessous."
          }
        }
      }
    },
