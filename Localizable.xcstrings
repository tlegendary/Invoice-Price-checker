    "%lld invoices weren't scanned because you had no scans left. One ad or one pack scan is needed for each invoice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم مسح %lld فواتير لأنه لم يتبقَّ لديك أي مسح. تحتاج كل فاتورة إلى إعلان واحد أو مسح واحد من باقة."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld پسوولە سکان نەکران چونکە هیچ سکانێکت نەمابوو. بۆ هەر پسوولەیەک ڕیکلامێک یان سکانێک لە پاکێجێک پێویستە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Rechnungen wurden nicht gescannt, weil du keine Scans mehr hattest. Pro Rechnung braucht es eine Werbung oder einen Scan aus einem Paket."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld factures n’ont pas été scannées car vous n’aviez plus de scans. Il faut une pub ou un scan d’un pack pour chaque facture."
          }
        }
      }
    },
