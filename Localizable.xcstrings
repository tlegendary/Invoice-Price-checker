    "By each invoice's date, calendar quarters. Check the dates match your VAT periods. Invoices billed twice and other currencies are left out." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسب تاريخ كل فاتورة، أرباع السنة الميلادية. تأكد أن التواريخ تطابق فترات ضريبتك. الفواتير المكررة والعملات الأخرى مستبعدة."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بەپێی بەرواری هەر پسوولەیەک، چارەکەکانی ساڵ. دڵنیابە بەروارەکان لەگەڵ ماوەکانی باجەکەت دەگونجێن. پسوولە دووبارەکان و دراوەکانی تر دەرهێنراون."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Datum jeder Rechnung, Kalenderquartale. Prüfe, ob die Daten zu deinen MwSt.-Zeiträumen passen. Doppelte Rechnungen und andere Währungen bleiben draußen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selon la date de chaque facture, par trimestres civils. Vérifiez que les dates correspondent à vos périodes de TVA. Les factures en double et les autres devises sont exclues."
          }
        }
      }
    },
