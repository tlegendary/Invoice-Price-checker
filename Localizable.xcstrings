    "Send an order, then compare it with what arrived and what you were billed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل طلبية، ثم قارنها بما وصل وما فُوتر عليك."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "داواکارییەک بنێرە، پاشان بەراوردی بکە لەگەڵ ئەوەی گەیشت و ئەوەی پارەی لێوەرگیرا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende eine Bestellung und vergleiche sie dann mit Lieferung und Rechnung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez une commande, puis comparez-la avec ce qui est arrivé et facturé."
          }
        }
      }
    },
    "Send it by WhatsApp, text or email, then tap I've sent it. When the invoice is checked, compare it here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسلها عبر واتساب أو رسالة أو بريد، ثم اضغط أرسلتها. بعد فحص الفاتورة، قارنها هنا."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بە واتسئاپ، نامە یان ئیمەیڵ بینێرە، پاشان کرتە لە ناردم بکە. کاتێک پسوولەکە پشکنرا، لێرە بەراوردی بکە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende sie per WhatsApp, SMS oder E-Mail und tippe dann auf Gesendet. Ist die Rechnung geprüft, vergleiche sie hier."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez-la par WhatsApp, SMS ou e-mail, puis touchez Je l'ai envoyée. Une fois la facture vérifiée, comparez-la ici."
          }
        }
      }
    },
