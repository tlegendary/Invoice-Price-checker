    },
    "How much is it for? The card number is on the receipt: they spend it with Gift card when they pay." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما قيمتها؟ رقم البطاقة على الإيصال: يستخدمونها باختيار بطاقة هدية عند الدفع."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بە چەندە؟ ژمارەی کارتەکە لەسەر پسوولەکەیە: لە کاتی پارەداندا بە کارتی دیاری بەکاری دەهێنن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
