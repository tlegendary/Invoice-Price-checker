          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci ressemble à un bon de livraison, pas à une facture. Vérifiez avant d’enregistrer."
          }
        }
      }
    },
    "This looks like a quote or pro forma, not an invoice. Check it before saving." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو هذا عرض سعر أو فاتورة مبدئية وليس فاتورة. تحقق منه قبل الحفظ."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ئەمە وەک نرخپێدان دیارە، نەک پسوولە. پێش پاشەکەوت بیپشکنە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sieht nach einem Angebot oder einer Proforma aus, nicht nach einer Rechnung. Vor dem Speichern prüfen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci ressemble à un devis ou une pro forma, pas à une facture. Vérifiez avant d’enregistrer."
          }
