          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ئەو پسوولانەی دەیپشکنیت لەگەڵ خاوەنەکە هاوبەش دەکرێن. نرخ، پارەدان و ڕێکخستنەکان خاوەنەکە بەڕێوەیان دەبات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
