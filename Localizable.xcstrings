    },
    "When a supplier charges more than the last time you bought the same item from them, it shows here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يفرض مورّد سعرًا أعلى من آخر مرة اشتريت فيها الصنف نفسه منه، يظهر هنا."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کاتێک دابینکەرێک زیاتر لە دوایین جار بۆ هەمان کاڵا وەردەگرێت، لێرە دەردەکەوێت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein Lieferant mehr berechnet als beim letzten Kauf desselben Artikels, erscheint es hier."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand un fournisseur facture plus cher que la dernière fois pour le même article, cela apparaît ici."
          }
        }
      }
    },
    "When you buy the same item from two suppliers, ChargeCheck shows here if the other one is cheaper." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما تشتري الصنف نفسه من مورّدَين، يعرض ChargeCheck هنا إن كان الآخر أرخص."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کاتێک هەمان کاڵا لە دوو دابینکەر دەکڕیت، ChargeCheck لێرە پیشانی دەدات ئەگەر ئەوی تر هەرزانتر بێت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du denselben Artikel bei zwei Lieferanten kaufst, zeigt ChargeCheck hier, ob der andere günstiger ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous achetez le même article chez deux fournisseurs, ChargeCheck indique ici si l’autre est moins cher."
          }
        }
      }
    },
    "Who are these prices from?" : {
      "localizations" : {
        "ar" : {
