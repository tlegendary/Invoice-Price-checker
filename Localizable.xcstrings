    "Money taken for gift cards isn't takings until the card is spent: it's owed to whoever holds the card." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المال المأخوذ مقابل بطاقات الهدايا ليس إيراداً حتى تُصرف البطاقة: إنه مستحق لحامل البطاقة."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ئەو پارەیەی بۆ کارتی دیاری وەرگیراوە داهات نییە تا کارتەکە خەرج دەکرێت: قەرزی ئەو کەسەیە کە کارتەکەی پێیە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geld für Geschenkkarten ist kein Umsatz, bis die Karte eingelöst wird: Es steht dem Karteninhaber zu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'argent des cartes cadeaux n'est pas du chiffre d'affaires tant que la carte n'est pas utilisée : il est dû à son porteur."
          }
        }
      }
    },
