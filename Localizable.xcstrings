    },
    "Scale labels carry" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملصقات الميزان تحمل"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لەیبڵی تەرازوو هەڵدەگرێت"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waagen-Etiketten enthalten"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étiquettes de balance indiquent"
          }
        }
      }
    },
    "Scale labels: barcodes starting with 2 printed by your shop scale. Give the item the first 7 digits of its label as a barcode. Points are earned on what's paid with money or on account, and spent at the till like money." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملصقات الميزان: رموز شريطية تبدأ بـ 2 يطبعها ميزان المحل. أعطِ الصنف أول 7 أرقام من ملصقه كرمز شريطي. تُكتسب النقاط على ما يُدفع بالمال أو على الحساب، وتُصرف على الكاشير مثل المال."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لەیبڵی تەرازوو: بارکۆدی دەستپێکراو بە 2 کە تەرازووی دووکانەکەت چاپی دەکات. یەکەم 7 ژمارەی لەیبڵەکە وەک بارکۆد بدە بە کاڵاکە. خاڵ لەسەر ئەوەی بە پارە یان لەسەر حیساب دەدرێت بەدەست دێت، و لە کاشێر وەک پارە خەرج دەکرێت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waagen-Etiketten: Barcodes mit 2 am Anfang, gedruckt von deiner Ladenwaage. Gib dem Artikel die ersten 7 Ziffern seines Etiketts als Barcode. Punkte gibt es auf Zahlungen mit Geld oder auf Rechnung, eingelöst werden sie an der Kasse wie Geld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étiquettes de balance : codes-barres commençant par 2 imprimés par la balance du magasin. Donnez à l'article les 7 premiers chiffres de son étiquette comme code-barres. Les points se gagnent sur ce qui est payé en argent ou sur compte, et se dépensent à la caisse comme de l'argent."
          }
        }
      }
    },
