    "Suppliers" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المورّدون"
          }
        },
        "ckb" : {
          "stringUnit" : {
