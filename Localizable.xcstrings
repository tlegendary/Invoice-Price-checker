    "You asked for %@ two weeks ago. Open ChargeCheck › Reports to mark it received or ask again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلبت %@ قبل أسبوعين. افتح ChargeCheck › التقارير لتسجيل استلامه أو اطلبه مرة أخرى."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوو هەفتە لەمەوبەر داوای %@ت کرد. ChargeCheck › ڕاپۆرتەکان بکەرەوە بۆ ئەوەی وەرگیراو دیاری بکەیت یان دووبارە داوا بکەیتەوە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast vor zwei Wochen %@ angefordert. Öffne ChargeCheck › Berichte, um sie als erhalten zu markieren oder erneut nachzufragen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez demandé %@ il y a deux semaines. Ouvrez ChargeCheck › Rapports pour le marquer comme reçu ou relancer."
          }
        }
      }
    },
