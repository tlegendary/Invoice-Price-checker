        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نرخێک زیاد بکە کە لەگەڵ %@ ڕێککەوتوویت ئەگەر جیاوازە لە نرخی ئاساییت. پسوولەکانی بەو نرخە دەپشکنرێن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
